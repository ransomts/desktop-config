#!/bin/sh
# stub (hypr-scripts-test): outputs in $W/randr.tsv (conn|model|enabled yes/no|transform|x|y)
#   list --kdl    prints them in cosmic-randr's KDL format
#   mode CONN W H --refresh R --transform T --pos-x X --pos-y Y
#                 records; enables CONN at T, X, Y; fails without changing anything if $W/randr-fail
case "$1" in
list)
    awk -F'|' '{ printf "output \"%s\" enabled=#%s {\n  description make=\"Fake\" model=\"%s\"\n  physical 600 340\n  position %s %s\n  scale 1.00\n  transform \"%s\"\n  adaptive_sync #false\n  modes {\n    mode 1920 1080 60000 current=#true preferred=#true\n  }\n}\n", $1, ($3 == "yes" ? "true" : "false"), $2, $5, $6, $4 }' "$W/randr.tsv" ;;
mode)
    echo "cosmic-randr $*" >> "$CALLS"
    [ -e "$W/randr-fail" ] && exit 1
    conn=$2; shift 4
    while [ $# -gt 0 ]; do
        case "$1" in --transform) tr=$2 ;; --pos-x) x=$2 ;; --pos-y) y=$2 ;; esac
        shift 2
    done
    awk -F'|' -v OFS='|' -v c="$conn" -v t="$tr" -v x="$x" -v y="$y" \
        '$1 == c { $3 = "yes"; $4 = t; $5 = x; $6 = y } { print }' "$W/randr.tsv" > "$W/randr.tmp"
    mv "$W/randr.tmp" "$W/randr.tsv" ;;
*) exit 2 ;;
esac
