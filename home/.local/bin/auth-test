#!/bin/sh
# Tests for the polkit prompt (Quickshell AuthPrompt.qml + AuthView.qml) and polkit-agent-start.
#
#   auth-test               run everything; PASS/FAIL lines and a summary; exit 1 on a failure
#   auth-test -v            also print everything Quickshell logged
#   auth-test -o PREFIX     save PREFIX-{dark,light}-{idle,typing,error}.png and PREFIX-dark-picker.png
#   auth-test -d DIR        test the config in DIR instead of ~/.config/quickshell
#   auth-test -b DIR        test polkit-agent-start in DIR instead of ~/.local/bin
#
# The real AuthPrompt (its layer window turned into a plain floating window: no compositor),
# AuthView and Theme run offscreen next to the stand-ins in tests/auth (FakeAgent, FakeFlow:
# the PolkitAgent/AuthFlow API with PAM played by timers). authprompt.qml, the only file that
# creates a real PolkitAgent, is never loaded, and the system bus is pointed at nothing, so no
# agent is ever registered with polkit. HOME, XDG_STATE_HOME and the runtime state file are
# temporary. Then: the test passwords must not appear in anything the run wrote (its output,
# Quickshell's own log file, the temporary directory); an agent that never registers must write
# "failed" and exit with code 3; polkit-agent-start runs against a stand-in systemctl and
# systemd-run that only record what they are asked.
verbose=0; out=""; src="$HOME/.config/quickshell"; bin="$HOME/.local/bin"
while [ $# -gt 0 ]; do
    case "$1" in
        -v) verbose=1 ;;
        -o) out="$2"; shift ;;
        -d) src="$2"; shift ;;
        -b) bin="$2"; shift ;;
        *) echo "usage: auth-test [-v] [-o PREFIX] [-d CONFIG_DIR] [-b BIN_DIR]" >&2; exit 2 ;;
    esac
    shift
done
qs="$HOME/.nix-profile/bin/qs"
tests="$src/tests/auth"
[ -x "$qs" ] && [ -f "$tests/shell.qml" ] || { echo "auth-test: no qs, or no $tests/shell.qml" >&2; exit 2; }
case "$out" in ""|/*) ;; *) out="$PWD/$out" ;; esac

work=$(mktemp -d) || exit 2
trap 'rm -rf "$work"' EXIT
cfg="$work/cfg"; fake="$work/home"
mkdir -p "$cfg" "$work/state" "$work/run" "$fake/.config/cosmic/com.system76.CosmicTheme.Mode/v1" "$fake/.local/share"
chmod 700 "$work/run"
echo true > "$fake/.config/cosmic/com.system76.CosmicTheme.Mode/v1/is_dark"
[ -e "$HOME/.local/share/fonts" ] && ln -s "$HOME/.local/share/fonts" "$fake/.local/share/fonts"
cp "$src/AuthView.qml" "$src/Theme.qml" "$cfg/" || exit 2
cp "$tests"/*.qml "$cfg/"
# PanelWindow -> FloatingWindow, without the layer-shell, anchors and screen lines
python3 - "$src/AuthPrompt.qml" "$cfg/AuthPrompt.qml" <<'PY' || exit 2
import sys
s = open(sys.argv[1], encoding="utf-8").read()
assert "PanelWindow {" in s
s = s.replace("PanelWindow {", "FloatingWindow {\n            implicitWidth: 960; implicitHeight: 620", 1)
drop = ("WlrLayershell.", "exclusionMode", "anchors { top: true", "screen: Quickshell.screens")
s = "\n".join(l for l in s.split("\n") if not any(d in l for d in drop))
open(sys.argv[2], "w", encoding="utf-8").write(s)
PY
if grep -l '^ *import  *Quickshell.Services.Polkit' "$cfg"/*.qml >/dev/null 2>&1; then
    echo "auth-test: a staged file imports Quickshell.Services.Polkit; refusing to run" >&2; exit 2
fi

run() {   # run [ENV=VALUE...]: the harness, offscreen, private session bus, no system bus
    env -u WAYLAND_DISPLAY -u DISPLAY -u HYPRLAND_INSTANCE_SIGNATURE -u QT_QPA_PLATFORMTHEME -u QT_STYLE_OVERRIDE \
        QT_QPA_PLATFORM=offscreen HOME="$fake" USER=tester XDG_STATE_HOME="$work/state" \
        DBUS_SYSTEM_BUS_ADDRESS=unix:path=/nonexistent/system_bus_socket \
        AUTH_STATE="$work/run/qs-polkit.state" AUTH_TEST_OUT="$out" "$@" \
        dbus-run-session -- timeout 120 "$qs" -p "$cfg/shell.qml" --no-color
}
log="$work/log"
run > "$log" 2>&1
code=$?
[ "$verbose" = 1 ] && cat "$log"
grep -o 'AUTHTEST \(PASS\|FAIL\|RESULT\).*' "$log" | sed 's/^AUTHTEST //'
if ! grep -q 'AUTHTEST RESULT' "$log"; then
    echo "auth-test: the run did not finish (exit $code). Last lines:" >&2
    grep -vE 'dbus-daemon|portal' "$log" | tail -15 >&2
    exit 2
fi
ok=0; grep -q 'AUTHTEST RESULT pass [0-9]* fail 0$' "$log" || ok=1
if grep -q 'Auth[A-Za-z]*\.qml.*\(TypeError\|ReferenceError\|Binding loop\|Cannot assign\|Unable to assign\)' "$log"; then
    echo "FAIL the prompt logged errors:"; grep 'Auth[A-Za-z]*\.qml' "$log" | sort -u | head -8; ok=1
fi

# the test passwords: in nothing the run wrote (output, Quickshell's log file, temporary files)
qslog=$(sed -n 's/.*Saving logs to "\(.*\)".*/\1/p' "$log" | head -1)
leak=0
for pw in Hunter2-zq9 Wr0ng-pw-x7; do
    grep -aqF "$pw" "$log" && leak=1
    [ -n "$qslog" ] && [ -f "$qslog" ] && grep -aqF "$pw" "$qslog" && leak=1
    grep -raqF "$pw" "$work/state" "$work/run" "$fake/.config" 2>/dev/null && leak=1
done
if [ "$leak" = 0 ] && [ -n "$qslog" ] && [ -f "$qslog" ]; then echo "PASS no test password in the output, Quickshell's log file or the state files"
elif [ "$leak" = 0 ]; then echo "PASS no test password in the output or the state files (Quickshell's log file not found)"
else echo "FAIL a test password appears in the run's output or files"; ok=1; fi
[ -n "$qslog" ] && rm -f "$qslog"

# an agent polkit never accepts: "failed" and exit 3 (so qs-polkit.service's OnFailure= fires)
rm -f "$work/run/qs-polkit.state"
run AUTH_NOREG=1 > "$work/log2" 2>&1
code=$?
[ "$verbose" = 1 ] && cat "$work/log2"
if [ "$code" = 3 ] && [ "$(cat "$work/run/qs-polkit.state" 2>/dev/null)" = failed ]; then
    echo "PASS not registered: writes failed and exits with code 3"
else echo "FAIL not registered: exit $code, state '$(cat "$work/run/qs-polkit.state" 2>/dev/null)'"; ok=1; fi
qslog=$(sed -n 's/.*Saving logs to "\(.*\)".*/\1/p' "$work/log2" | head -1); [ -n "$qslog" ] && rm -f "$qslog"

# polkit-agent-start against stand-ins (nothing real is started or stopped)
starter() {   # starter NAME EXPECT_OUTPUT [ENV=VALUE...] -- ARGS: run it with stand-ins in a fresh fake world
    name="$1"; want="$2"; shift 2
    w="$work/st-$name"; mkdir -p "$w/fakebin" "$w/home/.nix-profile/bin" "$w/home/.config/quickshell" "$w/run" "$w/active"
    printf '#!/bin/sh\nexit 0\n' > "$w/home/.nix-profile/bin/qs"; chmod +x "$w/home/.nix-profile/bin/qs"
    : > "$w/home/.config/quickshell/authprompt.qml"
    cat > "$w/fakebin/systemctl" <<'EOF'
#!/bin/sh
# stand-in: records the call; units are "active" while a file of their name is in $FAKE/active
echo "systemctl $*" >> "$FAKE/calls"
[ "$1" = --user ] && shift
q=0; [ "$1" = -q ] && { q=1; shift; }
cmd="$1"; shift
case "$cmd" in
    is-active) [ -e "$FAKE/active/$1" ] ;;
    start) [ "$1" = qs-polkit.service ] && [ -n "$FAKE_REGISTER" ] && { (sleep 0.3; echo registered > "$XDG_RUNTIME_DIR/qs-polkit.state") & }
           touch "$FAKE/active/$1" ;;
    stop) rm -f "$FAKE/active/$1" ;;
    cat) [ -n "$FAKE_UNIT" ] && [ "$1" = qs-polkit.service ] ;;
    list-jobs|reset-failed) exit 0 ;;
    *) exit 0 ;;
esac
EOF
    cat > "$w/fakebin/systemd-run" <<'EOF'
#!/bin/sh
echo "systemd-run $*" >> "$FAKE/calls"
touch "$FAKE/active/qs-polkit.service"
[ -n "$FAKE_REGISTER" ] && { (sleep 0.3; echo registered > "$XDG_RUNTIME_DIR/qs-polkit.state") & }
exit 0
EOF
    printf '#!/bin/sh\necho "pkill $*" >> "$FAKE/calls"\n' > "$w/fakebin/pkill"
    cp "$w/fakebin/pkill" "$w/fakebin/killall"
    chmod +x "$w/fakebin"/*
    touch "$w/active/graphical-session.target"
    [ -n "$PRE" ] && touch "$w/active/$PRE"
    [ -n "${NOQS:-}" ] && rm -f "$w/home/.nix-profile/bin/qs"
    while [ $# -gt 0 ] && [ "$1" != -- ]; do export "$1"; shift; done; shift
    got=$(env PATH="$w/fakebin:$PATH" HOME="$w/home" XDG_RUNTIME_DIR="$w/run" FAKE="$w" POLKIT_AGENT_WAIT=8 \
          "$bin/polkit-agent-start" "$@" 2>"$w/err" | tail -1)
    unset FAKE_REGISTER FAKE_UNIT
    calls="$w/calls"; touch "$calls"
    if [ "$got" = "$want" ] && ! grep -q '^pkill\|^killall' "$calls"; then echo "PASS starter: $name -> $got"
    else echo "FAIL starter: $name -> '$got' (wanted '$want')"; sed 's/^/    /' "$calls"; ok=1; fi
}
order() {   # order NAME FIRST SECOND: the first FIRST call comes before the last SECOND call in that run
    f=$(grep -n -F "$2" "$work/st-$1/calls" | head -1 | cut -d: -f1); s=$(grep -n -F "$3" "$work/st-$1/calls" | tail -1 | cut -d: -f1)
    if [ -n "$f" ] && [ -n "$s" ] && [ "$f" -lt "$s" ]; then echo "PASS starter: $1: '$2' before '$3'"
    else echo "FAIL starter: $1: '$2' not before '$3'"; ok=1; fi
}
has() {     # has NAME TEXT [not]
    if grep -q -F -- "$2" "$work/st-$1/calls"; then r=yes; else r=no; fi
    if { [ "$r" = yes ] && [ "${3:-}" != not ]; } || { [ "$r" = no ] && [ "${3:-}" = not ]; }; then echo "PASS starter: $1: ${3:+no }'$2'"
    else echo "FAIL starter: $1: ${3:+unexpected }'$2'"; ok=1; fi
}
if [ -x "$bin/polkit-agent-start" ]; then
    PRE=hyprpolkitagent.service starter switch quickshell FAKE_REGISTER=1 --
    order switch "stop hyprpolkitagent.service" "systemd-run"
    has switch "-p OnFailure=hyprpolkitagent.service"
    has switch "-p Conflicts=hyprpolkitagent.service"
    has switch "env -u QT_QPA_PLATFORMTHEME"
    has switch "/.config/quickshell/authprompt.qml"
    has switch "start hyprpolkitagent.service" not
    PRE=hyprpolkitagent.service starter no-register hyprpolkitagent --
    order no-register "systemd-run" "stop qs-polkit.service"
    order no-register "stop qs-polkit.service" "start hyprpolkitagent.service"
    PRE=qs-polkit.service starter revert hyprpolkitagent -- --hypr
    order revert "stop qs-polkit.service" "start hyprpolkitagent.service"
    PRE= starter status-none none -- --status
    PRE=hyprpolkitagent.service starter installed-unit quickshell FAKE_REGISTER=1 FAKE_UNIT=1 --
    has installed-unit "start qs-polkit.service"
    has installed-unit "systemd-run" not
    NOQS=1 PRE=hyprpolkitagent.service starter no-qs hyprpolkitagent --
    has no-qs "systemd-run" not
else echo "FAIL no $bin/polkit-agent-start"; ok=1; fi

if [ -n "$out" ]; then
    for p in dark-idle dark-typing dark-error dark-picker light-idle light-typing light-error; do
        if [ -s "$out-$p.png" ]; then echo "picture: $out-$p.png"; else echo "FAIL no picture $out-$p.png"; ok=1; fi
    done
fi
exit $ok
