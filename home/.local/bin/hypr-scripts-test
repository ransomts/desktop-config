if part lock-screen "lock-screen"; then
QML="$H/.config/quickshell/lockscreen.qml"
ls_fresh() { fresh; : > "$QML"; echo false > "$HS/locked"; rm -f "$rt/lock-screen.result" "$H/.nix-profile/bin/nixGLIntel"; }
ls_fresh; echo unlocked > "$work/lock-result"
run "$bin/lock-screen"
eq "lock and unlock: clear a stale hyprlock, keys display off, the lock in software mode, pet greets" "$(grep -v '^logger' "$calls" | tr '\n' ';')" \
   "pkill -x hyprlock;qs ipc call lecture keysoff;systemd-cat -t lock-screen $H/.nix-profile/bin/qs -p $QML --no-color;env QT_QUICK_BACKEND=software;qs -p $QML --no-color;qs ipc call pet greet;"
has "  journal: locked" "$(C)" "logger -t lock-screen -- locked"
has "  journal: unlocked after N s" "$(C)" "logger -t lock-screen -- unlocked after 0 s"
! grep -q "^hyprlock" "$calls"; check "  no hyprlock" $? "$(C)"
ls_fresh; echo unlocked > "$work/lock-result"
cp "$lib/home-stubs/nixGLIntel" "$H/.nix-profile/bin/"
run "$bin/lock-screen"
has "with nixGLIntel: the lock runs under it" "$(C)" "systemd-cat -t lock-screen $H/.nix-profile/bin/nixGLIntel $H/.nix-profile/bin/qs -p $QML --no-color"
hasnt "  and not in software mode" "$(C)" "QT_QUICK_BACKEND"
ls_fresh; echo gave-up > "$work/lock-result"
run "$bin/lock-screen"
grep -q "^hyprlock" "$calls"; check "lock ends without 'unlocked' (three wrong passwords): hyprlock takes over" $? "$(C)"
has "  with a warning naming the result" "$(C)" "logger -t lock-screen -p user.warning -- Quickshell lock ended with 'gave-up'; handing over to hyprlock"
hasnt "  no greeting" "$(C)" "pet greet"
ls_fresh; echo unlocked > "$rt/lock-screen.result"
run "$bin/lock-screen"
grep -q "^hyprlock" "$calls"; check "lock crashes (no result) with a stale 'unlocked' from last time: hyprlock" $? "$(C)"
has "  'no result' in the journal" "$(C)" "ended with 'no result'"
ls_fresh; rm -f "$QML"
run "$bin/lock-screen"
{ grep -q '^hyprlock' "$calls" && ! grep -q -- 'qs -p' "$calls"; }; check "no lockscreen.qml: straight to hyprlock" $? "$(C)"
ls_fresh; mv "$H/.nix-profile/bin/qs" "$work/qs.away"
run "$bin/lock-screen"; mv "$work/qs.away" "$H/.nix-profile/bin/qs"
{ grep -q '^hyprlock' "$calls" && ! grep -q '^qs' "$calls"; }; check "no Quickshell: straight to hyprlock" $? "$(C)"
ls_fresh; echo true > "$HS/locked"
run "$bin/lock-screen"; rc=$?
{ [ $rc = 0 ] && [ -z "$(grep -vE '^(logger)' "$calls")" ]; }; check "already locked (hyprctl locked): does nothing, leaves hyprlock alone" $? "rc=$rc $(C)"
ls_fresh
( exec 9>"$rt/lock-screen.pid"; flock 9; run "$bin/lock-screen" ); rc=$?
{ [ $rc = 0 ] && [ ! -s "$calls" ]; }; check "already locking (lock file held): exits at once" $? "rc=$rc $(C)"
fi

