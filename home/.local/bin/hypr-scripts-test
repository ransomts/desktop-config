if part display-menu "display-menu (menu)"; then
printf 'monitor({ output = "desc:DELL P2425HE", mode = "1920x1080" })\nmonitor({ output = "desc:S34J55x" })\n' > "$H/.config/hypr/hyprland.lua"
LAP="$(mon eDP-1 "AU Optronics 0x683D" 1920 1080 1 0 0 0 true)"
DSK="$(mon DP-5 "DELL P2425HE" 1920 1080 1 0 1920 0 false)"
PRJ="$(mon HDMI-A-1 "Epson projector" 1920 1080 1 0 0 0 false)"
dm() { fresh; setmons "$1"; [ -n "${2:-}" ] && echo "$2" > "$work/pick-grep"; [ "${3:-}" = presenting ] && : > "$rt/presenting"; [ "${3:-}" = presenting ] || rm -f "$rt/presenting"; run "$bin/display-menu"; }
dm "$LAP,$DSK,$PRJ" Mirror
has "Mirror: Display.set('mirror', projector)" "$(HC)" "hyprctl eval Display.set('mirror', 'HDMI-A-1')"
eq "  starts presenting: flag, DND on, hypridle stopped (service and strays), bar refresh, notice" \
   "$(grep -vE '^(hyprctl|qs-pick)' "$calls" | sed 's/ Notifications.*//' | tr '\n' ';')" \
   "notif-dnd on;systemctl --user stop hypridle.service;pkill -x hypridle;bar-refresh 9;notify-send -u critical -a Displays Presenting;"
[ -e "$rt/presenting" ]; check "  presenting flag set" $?
has "  menu named the projector" "$(C)" "qs-pick --prompt 󰍹   --placeholder Displays — projector: HDMI-A-1"
eq "  five choices with a projector" "$(wc -l < "$work/pick-input" | tr -d ' ')" 5
dm "$LAP,$DSK,$PRJ" "Projector only"
{ grep -qF "Display.set('projector', 'HDMI-A-1')" "$calls" && grep -q 'notif-dnd on' "$calls"; }; check "Projector only: set projector, present" $? "$(C)"
dm "$LAP,$DSK,$PRJ" Extend presenting
has "Extend: Display.set('extend', ...)" "$(HC)" "hyprctl eval Display.set('extend', 'HDMI-A-1')"
eq "  ends presenting: lecture tools off, DND off, quiet resync, hypridle back, bar refresh" \
   "$(grep -vE '^(hyprctl|qs-pick)' "$calls" | tr '\n' ';')" \
   "qs ipc call lecture off;notif-dnd off;qs ipc call quiet resync;systemctl --user start hypridle.service;bar-refresh 9;"
[ ! -e "$rt/presenting" ]; check "  presenting flag cleared" $?
dm "$LAP,$DSK,$PRJ" "Laptop only" presenting
{ grep -qF "Display.set('laptop', 'HDMI-A-1')" "$calls" && grep -q 'notif-dnd off' "$calls" && [ ! -e "$rt/presenting" ]; }; check "Laptop only: set laptop, unpresent" $? "$(C)"
dm "$LAP,$DSK,$PRJ" "Laptop screen"
eq "Laptop screen on/off: only the toggle" "$(grep -v '^qs-pick' "$calls" | tr '\n' ';')" "hyprctl eval Display.laptop_toggle();"
dm "$LAP,$DSK"
eq "no projector: one choice" "$(cat "$work/pick-input")" "󰶐  Laptop screen on/off"
has "  placeholder without a projector" "$(C)" "--placeholder Displays"
hasnt "  (no projector named)" "$(C)" "projector:"
dm "$LAP,$DSK,$PRJ"
eq "cancelled: nothing changes" "$(grep -v '^qs-pick' "$calls" | tr '\n' ';')" ""
fi

