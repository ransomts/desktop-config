if part hyprland-log "hyprland-log"; then
fresh; rm -rf "$rt/hypr" "$state/hyprland-logs"
keep="$state/hyprland-logs"; mkdir -p "$keep" "$rt/hypr/abc_1700000000_111" "$rt/hypr/def_1700000500_222" "$rt/hypr/ghi_1700000900_333"
printf 'DEBUG one\nWARN two\n' > "$rt/hypr/abc_1700000000_111/hyprland.log"
printf 'second instance\n' > "$rt/hypr/def_1700000500_222/hyprland.log"
: > "$rt/hypr/ghi_1700000900_333/hyprland.log"
for i in 1 2 3 4 5 6 7 8; do echo old > "$keep/hyprland-16000000${i}0_9.log.gz"; touch -d "2026-01-0$i 12:00" "$keep/hyprland-16000000${i}0_9.log.gz"; done
run "$bin/hyprland-log" save
eq "save: each instance's log compressed under its time_pid" "$(gzip -dc "$keep/hyprland-1700000000_111.log.gz" | tr '\n' ';')|$(gzip -dc "$keep/hyprland-1700000500_222.log.gz")" "DEBUG one;WARN two;|second instance"
[ ! -e "$keep/hyprland-1700000900_333.log.gz" ]; check "save: an empty log is skipped" $?
eq "save: newest 6 kept (the two new, the four newest old)" "$(/bin/ls "$keep" | tr '\n' ' ')" \
   "hyprland-1600000050_9.log.gz hyprland-1600000060_9.log.gz hyprland-1600000070_9.log.gz hyprland-1600000080_9.log.gz hyprland-1700000000_111.log.gz hyprland-1700000500_222.log.gz "
[ -z "$(find "$keep" -name '.tmp.*')" ]; check "save: no temp file left" $?
printf 'DEBUG one\nWARN two\nERR three\n' > "$rt/hypr/abc_1700000000_111/hyprland.log"
run "$bin/hyprland-log" save
eq "save again: the same file is refreshed, not duplicated" "$(gzip -dc "$keep/hyprland-1700000000_111.log.gz" | wc -l | tr -d ' ') $(/bin/ls "$keep" | wc -l | tr -d ' ')" "3 6"
fresh; run "$bin/hyprland-log" follow 2>/dev/null; rc=$?
{ [ $rc = 1 ] && [ ! -s "$calls" ]; }; check "follow outside Hyprland: exit 1" $? "rc=$rc"
run env HYPRLAND_INSTANCE_SIGNATURE=nope_1_2 "$bin/hyprland-log" follow 2>/dev/null; rc=$?
[ $rc = 1 ]; check "follow with no log file: exit 1" $? "rc=$rc"
printf 'DEBUG [x] noise\nWARN something odd\nINFO hi\nERR broken\nCRIT dead\n  WARN not at the start\n' > "$rt/hypr/abc_1700000000_111/hyprland.log"
run env HYPRLAND_INSTANCE_SIGNATURE=abc_1700000000_111 "$bin/hyprland-log" follow
eq "follow: only WARN/ERR/CRIT lines, with journal priorities" "$(tr '\n' ';' < "$work/journal")" "<4>WARN something odd;<3>ERR broken;<2>CRIT dead;"
has "  read with tail -n 0 -F (new lines only, across log rotation)" "$(C)" "tail -n 0 -F $rt/hypr/abc_1700000000_111/hyprland.log"
has "  sent with the tag hyprland" "$(C)" "systemd-cat -t hyprland"
run "$bin/hyprland-log" 2>/dev/null; [ $? = 2 ]; check "no mode: usage, exit 2" $?
fi

