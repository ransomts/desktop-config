if part logout-confirm "logout-confirm"; then
lc() { run env LOGOUT_CMD="echo LOGOUT >> \"\$CALLS\"" "$bin/logout-confirm"; }
stamp="$rt/logout-confirm.stamp"
fresh; rm -f "$stamp"
lc
hasnt "first press: no log-out" "$(C)" "LOGOUT"
has "  a critical notice that replaces itself" "$(C)" "notify-send -u critical -t 4000 -h string:x-canonical-private-synchronous:logout-confirm Log out? Press Super+Shift+E again to log out."
{ [ -f "$stamp" ] && [ $(( $(date +%s) - $(cat "$stamp") )) -le 1 ]; }; check "  stamp holds the time" $?
: > "$calls"; lc
eq "second press within 4 s: logs out, no notice" "$(C)" "LOGOUT;"
[ ! -e "$stamp" ]; check "  and clears the stamp (a third press starts over)" $?
fresh; echo $(( $(date +%s) - 3 )) > "$stamp"; lc
has "press 3 s after the first: logs out" "$(C)" "LOGOUT"
fresh; echo $(( $(date +%s) - 6 )) > "$stamp"; lc
hasnt "press 6 s after the first: only asks again" "$(C)" "LOGOUT"
[ "$(cat "$stamp")" -ge $(( $(date +%s) - 1 )) ]; check "  with a fresh stamp" $?
fresh; echo garbage > "$stamp"; lc
hasnt "a garbled stamp counts as no press" "$(C)" "LOGOUT"
fresh; rm -f "$stamp"; echo 1 > "$work/notify-rc"; lc
has "no notification daemon: falls back to hyprctl notify" "$(C)" "hyprctl notify 1 4000 0 Log out? Press Super+Shift+E again"
fresh; date +%s > "$stamp"
run "$bin/logout-confirm"
eq "real log-out: session-save --if-enabled, then uwsm stop" "$(C)" "session-save --if-enabled;uwsm stop;"
fi

