if part dock-monitor-layout "dock-monitor-layout"; then
DESK="DP-5|DELL P2425HE|yes|normal|0|840
DP-6|DELL P2214H|yes|rotate90|1920|0
DP-7|S34J55x|yes|normal|3000|480
eDP-1|0x683D|yes|normal|6440|840"
kern() { mkdir -p "$work/drm/card1-$1"; echo "$2" > "$work/drm/card1-$1/status"; echo "$3" > "$work/drm/card1-$1/edid"; }
desk_kernel() { kern DP-5 connected "DELL P2425HE"; kern DP-6 connected "DELL P2214H"; kern DP-7 connected S34J55x; kern eDP-1 connected 0x683D; kern DP-1 disconnected ""; }
dml() { run env DOCK_DRM_SYSFS="$work/drm" "$bin/dock-monitor-layout"; }
modes() { grep '^cosmic-randr mode' "$calls" | tr '\n' ';'; }
fresh; echo "$DESK" > "$work/randr.tsv"; desk_kernel
dml
eq "everything already in place: no changes" "$(modes)" ""
has "then waits for drm hotplug events" "$(C)" "udevadm monitor --udev --subsystem-match=drm"
fresh; desk_kernel
printf 'eDP-1|0x683D|yes|normal|6440|840\nDP-9|S34J55x|yes|normal|0|0\nDP-10|DELL P2425HE|yes|normal|3440|0\nDP-11|DELL P2214H|yes|normal|5360|0\n' > "$work/randr.tsv"
dml
eq "dock attached on other DP numbers: each monitor set by its model, laptop left alone" "$(modes)" \
   "cosmic-randr mode DP-10 1920 1080 --refresh 60.000 --transform normal --pos-x 0 --pos-y 840;cosmic-randr mode DP-11 1920 1080 --refresh 60.000 --transform rotate90 --pos-x 1920 --pos-y 0;cosmic-randr mode DP-9 3440 1440 --refresh 59.973 --transform normal --pos-x 3000 --pos-y 480;"
has "  one settling pass afterwards (sleep 1), which finds nothing to do" "$(cat "$work/sleeps")" "sleep 1"
eq "  layout now as wanted" "$(sort "$work/randr.tsv" | tr '\n' ';')" "DP-10|DELL P2425HE|yes|normal|0|840;DP-11|DELL P2214H|yes|rotate90|1920|0;DP-9|S34J55x|yes|normal|3000|480;eDP-1|0x683D|yes|normal|6440|840;"
fresh; desk_kernel; sed 's/^DP-6|DELL P2214H|yes/DP-6|DELL P2214H|no/; s/^eDP-1|0x683D|yes|normal|6440|840/eDP-1|0x683D|yes|normal|0|0/' <<< "$DESK" > "$work/randr.tsv"
dml
eq "a disabled desk monitor in place is enabled; a misplaced laptop panel is moved" "$(modes)" \
   "cosmic-randr mode DP-6 1920 1080 --refresh 60.000 --transform rotate90 --pos-x 1920 --pos-y 0;cosmic-randr mode eDP-1 1920 1080 --refresh 60.049 --transform normal --pos-x 6440 --pos-y 840;"
fresh; desk_kernel; sed 's/^DP-7|S34J55x|yes|normal|3000|480/DP-7|S34J55x|yes|normal|0|0/' <<< "$DESK" > "$work/randr.tsv"; : > "$work/randr-fail"
dml
eq "cosmic-randr refusing: one retry pass, no endless loop" "$(grep -c '^cosmic-randr mode DP-7' "$calls")" 2
has "  and the failure is logged" "$(C)" "logger -t dock-monitor-layout failed to configure DP-7"
fresh; kern DP-1 disconnected ""; kern eDP-1 connected 0x683D; echo 'eDP-1|0x683D|yes|normal|0|0' > "$work/randr.tsv"
dml
{ [ -z "$(modes)" ] && ! grep -qE '^(sudo|notify-send)' "$calls"; }; check "not at the desk: no changes, no re-plug, no popup" $? "$(C)"
eq "  after waiting up to 15 s for the desk set" "$(grep -c 'sleep 1' "$work/sleeps")" 15
fresh; desk_kernel; grep -v S34J55x <<< "$DESK" > "$work/randr.tsv"
dml
eq "kernel sees the ultrawide but COSMIC doesn't list it: re-plug just its connector" "$(grep '^sudo' "$calls" | tr '\n' ';')" "sudo -n /usr/local/sbin/drm-reprobe DP-7;"
has "  and log the try" "$(C)" "re-plugging DP-7 (try 1/2)"
eq "  nothing configured meanwhile" "$(modes)" ""
fresh; desk_kernel; grep -v S34J55x <<< "$DESK" > "$work/randr.tsv"
printf 'emit UDEV  [10.1] change   /devices/pci0000:00/0000:00:02.0/drm/card1 (drm)\npause 3.5\nemit UDEV  [14.1] change   /devices/pci0000:00/0000:00:02.0/drm/card1 (drm)\n' > "$work/udev-script"
dml
eq "still mis-registered after two re-plugs: no third, a popup instead" "$(grep -c '^sudo' "$calls") $(grep -c "^notify-send -a Monitors S34J55x isn't set up right" "$calls")" "2 1"
has "  and the journal says to power-cycle it" "$(C)" "COSMIC still has S34J55x (DP-7) wrong after 2 re-plugs; power-cycle it by hand"
fresh; desk_kernel; grep -v S34J55x <<< "$DESK" > "$work/randr.tsv"
cat > "$work/udev-script" <<'EOF'
run echo 'DP-7|S34J55x|yes|normal|3000|480' >> "$W/randr.tsv"
emit UDEV  [10.1] change   /devices/pci0000:00/0000:00:02.0/drm/card1 (drm)
pause 4.5
run grep -v S34J55x "$W/randr.tsv" > "$W/randr.x"; mv "$W/randr.x" "$W/randr.tsv"
emit UDEV  [20.1] change   /devices/pci0000:00/0000:00:02.0/drm/card1 (drm)
EOF
dml
eq "a good layout in between resets the re-plug count" "$(grep -o 'try [0-9]/2' "$calls" | tr '\n' ' ')" "try 1/2 try 1/2 "
fresh; desk_kernel; grep -v S34J55x <<< "$DESK" > "$work/randr.tsv"
printf 'emit monitor will print the received events for:\nemit UDEV - the event which udev sends out after rule processing\nemit \n' > "$work/udev-script"
dml
eq "udevadm's header lines alone cause no layout pass (no second re-plug try)" "$(grep -c '^sudo' "$calls")" 1
fi

