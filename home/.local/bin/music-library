#!/bin/bash
# music-library: show / hide the Emacs music library (the mpc.el frame named
# "Music", see ~/.emacs.d/docs/music.org), which lives on the special workspace
# "library" the way ncmpcpp lives on "music" (~/.local/bin/music).
#
#   music-library        toggle it (open it first if it isn't open)
#   music-library show   show it, opening it if needed; never hides
#
# The Hyprland rule "emacs-music" floats the frame on special:library when it
# maps, so C-c m l inside Emacs lands there too.  Bound to Super+Shift+`.
set -u
ws=library
title='^Music$'
toggle() { hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$ws\")" >/dev/null; }
# The workspace the Music frame is on, or nothing if it isn't open.
where() {
    hyprctl clients -j | python3 -c '
import json, sys
for c in json.load(sys.stdin):
    if c["class"] == "emacs" and c["title"] == "Music":
        print(c["workspace"]["name"]); break'
}
showing() {
    hyprctl monitors -j | python3 -c '
import json, sys
sys.exit(0 if any(m["focused"] and m["specialWorkspace"]["name"] == "special:'"$ws"'"
                  for m in json.load(sys.stdin)) else 1)'
}
# Same proportions as ncmpcpp: 62% of the monitor's height, 62% of its width
# but at most 1.7x the height.
fit() {
    local size
    size=$(hyprctl monitors -j | python3 -c '
import json, sys
for m in json.load(sys.stdin):
    if m["focused"]:
        w, h = m["width"] / m["scale"], m["height"] / m["scale"]
        if m["transform"] % 2: w, h = h, w
        H = round(h * 0.62); W = round(min(w * 0.62, H * 1.7))
        print(W, H)')
    [ -n "$size" ] || return 0
    hyprctl dispatch "hl.dsp.window.resize({ x = ${size% *}, y = ${size#* }, window = \"title:$title\" })" >/dev/null
    hyprctl dispatch "hl.dsp.window.center({ window = \"title:$title\" })" >/dev/null
}

mode=${1:-toggle}
case "$mode" in toggle|show) ;; *) echo "usage: music-library [toggle|show]" >&2; exit 2 ;; esac

on=$(where)
if [ -z "$on" ]; then
    # A new frame from the daemon, set up as the library (tsr/music-library-here).
    timeout 15 emacsclient -c -n -F '((name . "Music"))' -e '(tsr/music-library-here)' >/dev/null 2>&1
    for _ in $(seq 50); do on=$(where); [ -n "$on" ] && break; sleep 0.1; done
    if [ -z "$on" ]; then logger -t music-library "the Music frame didn't appear"; exit 1; fi
    mode=show
fi
# Opened some other way before the rule existed, or moved off by hand.
if [ "$on" != "special:$ws" ]; then
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:$ws\", window = \"title:$title\", follow = false })" >/dev/null
    mode=show
fi
if [ "$mode" = show ]; then
    showing || toggle
else
    toggle
fi
showing && fit
exit 0
