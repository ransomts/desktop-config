#!/bin/bash
# Screenshots of the desktop for the public repo's README, taken from a STAGED session: a nested
# Hyprland running the published config with demo data, so nothing personal can be in a picture.
#
#   desktop-shots [-o OUTDIR] [-s SRC] [-k] [-v] [--only NAME[,NAME...]] [--dark-only|--light-only]
#
#   -o OUTDIR   where the PNGs go (default ~/Code/desktop-config/screenshots)
#   -s SRC      the home tree to stage from (default ~/Code/desktop-config/home, the scrubbed public
#               export, so the pictures show what is published; run desktop-export first)
#   -k          keep the temporary directory (printed)
#   -v          print the shell's log and the recorded commands at the end
#   --only      only these shots (names below)
#   --hold      set the session up, write TMP/env.sh (sourceable: hc, qsi, shoot, ptr, kbd) and wait
#               until TMP/stop exists; for working on this script
#   --keys FILE also write the key-binding page (keybind-sheet --org) from the nested session's bindings
#   PNGs are run through pngquant when it is installed (they are committed, so size matters).
#
# Shots (each in dark and light: NAME-dark.png, NAME-light.png):
#   wallpaper     the empty desktop: wallpaper and bar
#   desktop       wallpaper, bar and two tiled terminal windows
#   launcher      the launcher over the desktop
#   panel         the control panel
#   notifications popups from a few demo notifications
#   dashboard     the dashboard
#   overview      the desktop overview
#   settings      the settings window
#   bar           a crop of the bar strip (from desktop)
#   lecture       ink drawn over code and the countdown timer
#   spotlight     the lecture spotlight on a few lines of code
#   keys          the lecture key display
#   editor        the screenshot editor with marks (pointer and keys through vptr/vkbd)
#   lock          the lock screen
# Dark only:
#   calc, emoji   launcher modes with a query typed
#   scenes        a grid of every wallpaper scene
# Gallery (--gallery-only for just these; into OUTDIR/gallery/, dark, each cropped to what it shows):
#   every bar popup, launcher mode and settings page, the switcher, wallpaper menu, OSD, screensaver,
#   lecture zoom and menu, webcam bubble and recording, share picker, polkit prompt (auth-test's
#   pictures), battery warning, break reminder, pet pages and game, wallpaper effects, and four
#   interaction clips (drag-to-place, border resize, pill clicks, Do Not Disturb). Bluetooth, Wi-Fi,
#   battery, power profiles and music come from desktop-shots-fakes; sound from a private PipeWire.
# Animations (animated AVIF, recorded with wf-recorder; --no-anim skips them):
#   anim-wallpaper  anim-island  anim-pet  anim-theme
#
# Isolation is shell-boot-test's: temporary HOME and XDG dirs, private session and "system" D-Bus
# buses, a deny-by-default PATH where every program not on a short allow list is a recorder, every
# ~/.local/bin script a recorder except a few offline status ones, Hyprland's own exec_cmd recorded.
# Demo data: a calendar file with made-up events, made-up notifications, no mail, no network.
# The nested Hyprland shows as a window on your desktop while it runs (about a minute).
set -u
out="$HOME/Code/desktop-config/screenshots"; src="$HOME/Code/desktop-config/home"
keep=0; verbose=0; only=""; modes="dark light"; keys=""; hold=0; anim=1
while [ $# -gt 0 ]; do
    case "$1" in
        -o) out="$2"; shift ;;
        -s) src="$2"; shift ;;
        -k) keep=1 ;;
        -v) verbose=1 ;;
        --only) only=",$2,"; shift ;;
        --keys) keys="$2"; shift ;;
        --hold) hold=1; keep=1 ;;
        --no-anim) anim=0 ;;
        --gallery-only) only=",gallery," ;;
        --dark-only) modes=dark ;;
        --light-only) modes=light ;;
        *) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
    esac
    shift
done
want() { case "$1" in anim-*) [ "$anim" = 1 ] || return 1 ;; esac; [ -z "$only" ] || [[ "$only" == *",$1,"* ]]; }

QS="$HOME/.nix-profile/bin/qs"; GL="$HOME/.nix-profile/bin/nixGLIntel"
qsrc="$src/.config/quickshell"; hsrc="$src/.config/hypr"; htests="$hsrc/tests"
for need in Hyprland hyprctl jq dbus-daemon python3 grim ghostty; do
    command -v "$need" >/dev/null || { echo "desktop-shots: needs $need" >&2; exit 2; }
done
[ -x "$QS" ] || { echo "desktop-shots: no qs at $QS" >&2; exit 2; }
[ -f "$qsrc/shell.qml" ] && [ -f "$hsrc/hyprland.lua" ] && [ -d "$htests/stubs" ] \
    || { echo "desktop-shots: $src does not hold .config/quickshell/shell.qml, .config/hypr/hyprland.lua and its tests/stubs" >&2; exit 2; }
[ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] || { echo "desktop-shots: needs a Wayland session to open the nested one in" >&2; exit 2; }
case "$WAYLAND_DISPLAY" in /*) live_wl="$WAYLAND_DISPLAY" ;; *) live_wl="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ;; esac
mkdir -p "$out" || exit 2
out=$(realpath "$out")

live_env() { systemctl --user show-environment 2>/dev/null | grep -E '^(WAYLAND_DISPLAY|DISPLAY|HYPRLAND_INSTANCE_SIGNATURE|PATH)=' | sort; }
env_before=$(live_env)

work=$(mktemp -d) || exit 2
H="$work/home"; R="$work/run"; LOG="$work/exec.log"; P="$work/path"; QLOG="$work/qs.log"
mkdir -p "$H/.config" "$H/.local/bin" "$H/.local/lib/hyprland" "$H/.local/state" "$H/.local/share" "$H/.cache" \
         "$H/.nix-profile/bin" "$R" "$P" && chmod 700 "$R"
cp -r "$hsrc" "$H/.config/hypr"
mkdir -p "$H/.config/quickshell"
( cd "$qsrc" && tar --exclude=./tests --exclude='*.orig' -cf - . ) | tar -C "$H/.config/quickshell" -xf -
for d in ghostty gtk-3.0 gtk-4.0 qt5ct qt6ct fuzzel; do [ -d "$src/.config/$d" ] && cp -r "$src/.config/$d" "$H/.config/$d"; done
[ -f "$HOME/.local/lib/hyprland/strict-resize.so" ] && ln -s "$HOME/.local/lib/hyprland/strict-resize.so" "$H/.local/lib/hyprland/"
for d in fonts icons; do [ -d "$HOME/.local/share/$d" ] && ln -s "$HOME/.local/share/$d" "$H/.local/share/$d"; done
ln -s "$QS" "$H/.nix-profile/bin/qs"
: > "$LOG"; : > "$work/started"

cat > "$work/rec" <<'EOF'
#!/bin/sh
printf '%s %s\n' "$(basename "$0")" "$*" >> "${SBT_LOG:-/dev/null}"
exit 0
EOF
chmod +x "$work/rec"
# ~/.local/bin: the published scripts, each a recorder except these offline status ones (they read
# only the temporary HOME; anything they run goes through the PATH below)
real_scripts="dnd-toggle notif-dnd drives agenda-day tz-now sunset-times shell-status cursor-track"
for f in "$src"/.local/bin/* "$HOME"/.local/bin/*; do
    n=${f##*/}; [ -e "$H/.local/bin/$n" ] && continue
    case " $real_scripts " in *" $n "*) cp "$f" "$H/.local/bin/$n" ;; *) ln -s "$work/rec" "$H/.local/bin/$n" ;; esac
done
rm -f "$H/.local/bin/shell-health"
cat > "$H/.local/bin/shell-health" <<'CANNED'
#!/bin/sh
echo '{"worst": "ok", "jobs": []}'
CANNED
chmod +x "$H/.local/bin/shell-health"
rm -f "$H/.local/bin/dashboard-data"       # made-up numbers, weather and mail for the dashboard
cat > "$H/.local/bin/dashboard-data" <<'CANNED'
#!/usr/bin/env python3
import datetime as dt, json, sys
if sys.argv[1:] == ["sys"]:
    print(json.dumps({"cpu": 0.12, "mem": 0.31, "mem_gb": 12.2, "mem_total_gb": 39, "temp": 47, "load": "0.84",
                      "uptime": "3d 4h", "disks": [{"name": "System", "used": 0.52, "free_gb": 220},
                                                   {"name": "Data", "used": 0.38, "free_gb": 610}]}))
    sys.exit()
d = dt.date.today()
days = [{"name": "Today" if i == 0 else (d + dt.timedelta(i)).strftime("%a"), "glyph": g, "words": w,
         "hi": hi, "lo": lo, "rain": r} for i, (g, w, hi, lo, r) in enumerate(
        [("", "Mostly clear", 64, 41, 0), ("", "Partly cloudy", 61, 44, 10),
         ("", "Showers", 55, 46, 70), ("", "Clear", 59, 38, 0)])]
tom = d + dt.timedelta(1)
print(json.dumps({
    "weather": {"ok": True, "temp": 58, "feels": 56, "words": "Mostly clear", "glyph": "", "wind": 6,
                "humidity": 48, "sunrise": "07:12", "sunset": "17:28", "days": days},
    "mail": {"boxes": [{"name": "Work", "unread": 3}, {"name": "Personal", "unread": 1}], "latest": []},
    "tomorrow": {"name": tom.strftime("%A"), "events": [
        {"start": "09:30", "end": "10:20", "title": "Algorithms lecture", "allday": False, "location": "Hall B 100",
         "url": "", "date": tom.isoformat(), "id": "", "calendar": "demo", "tags": []},
        {"start": "14:00", "end": "15:00", "title": "Student meetings", "allday": False, "location": "Room 210",
         "url": "", "date": tom.isoformat(), "id": "", "calendar": "demo", "tags": []}]}}))
CANNED
chmod +x "$H/.local/bin/dashboard-data"
# ---- made-up data for the gallery views (bar popups, launcher modes) ----
canned() { rm -f "$H/.local/bin/$1"; cat > "$H/.local/bin/$1"; chmod +x "$H/.local/bin/$1"; }
canned screen-record <<'CANNED'
#!/bin/sh
[ "$1" = status ] && [ -e "$HOME/demo/recording" ] && echo '{"text": "REC 0:42", "tooltip": "<b>Recording</b> this screen, 0:42\nClick: stop", "class": "recording"}'
exit 0
CANNED
canned charge-profile <<'CANNED'
#!/bin/sh
[ "$1" = status ] && echo '{"profile": "balanced", "start": 86, "end": 90}'
exit 0
CANNED
canned cams <<'CANNED'
#!/bin/sh
[ -z "$1" ] && printf '/dev/v4l/by-id/demo-camera\tDemo camera\t/dev/video9\n'
exit 0
CANNED
canned teams-unread <<'CANNED'
#!/bin/sh
# one line: the bar escapes newlines before parsing
[ -z "$1" ] && echo '{"text": "3", "tooltip": "<b>Teams</b>: 3 unread in 2 chats", "class": "unread", "rooms": [{"id": "a", "name": "CS 2120 TAs", "count": 2, "mentions": 1, "preview": "Lab 7 grading is done, posting tonight"}, {"id": "b", "name": "Curriculum committee", "count": 1, "mentions": 0, "preview": "Agenda for Thursday attached"}]}'
exit 0
CANNED
canned mu <<'CANNED'
#!/bin/sh
[ "$1" = find ] || exit 0
printf '%s\t%s\t%s\t%s\n' "Today 09:12" "Sam Rivera <sam@example.edu>" "Question about the linked list lab" "m1@example" \
    "Today 08:40" "Department office <office@example.edu>" "Room change for Thursday" "m2@example" \
    "Yesterday" "Library <library@example.edu>" "Your reserve items are ready" "m3@example"
CANNED
canned tabs-list <<'CANNED'
#!/bin/sh
cat <<'EOF'
[{"title": "Course syllabus", "url": "https://example.edu/cs2120/syllabus", "host": "example.edu", "window": 1, "index": 1, "active": true, "pinned": false},
 {"title": "Quickshell documentation", "url": "https://quickshell.org/docs/", "host": "quickshell.org", "window": 1, "index": 2, "active": false, "pinned": true},
 {"title": "Hyprland wiki", "url": "https://wiki.hypr.land/", "host": "wiki.hypr.land", "window": 1, "index": 3, "active": false, "pinned": false},
 {"title": "Org mode manual", "url": "https://orgmode.org/manual/", "host": "orgmode.org", "window": 2, "index": 1, "active": true, "pinned": false}]
EOF
CANNED
mkdir -p "$H/demo/real"; cp "$src/.local/bin/quick-event" "$H/demo/real/quick-event" 2>/dev/null
canned quick-event <<'CANNED'
#!/bin/sh
# only `parse` reaches the real script; adding an event never runs here
[ "$1" = parse ] && exec python3 "$HOME/demo/real/quick-event" "$@"
exit 0
CANNED
canned shell-health <<'CANNED'
#!/bin/sh
if [ -e "$HOME/demo/health-stale" ]; then cat <<'EOF'
{"worst": "stale", "jobs": [
 {"id": "mail", "name": "Mail sync", "state": "stale", "since": "2026-11-21T08:10:00-05:00", "why": "last good run 52 min ago", "unit": "pull-mail.service", "log": "", "run": ""},
 {"id": "backup", "name": "Backups", "state": "ok", "since": "2026-11-21T02:00:00-05:00", "why": "", "unit": "backup.service", "log": "", "run": ""},
 {"id": "calendar", "name": "Calendar pull", "state": "ok", "since": "2026-11-21T09:00:00-05:00", "why": "", "unit": "pull-calendars.service", "log": "", "run": ""},
 {"id": "updates", "name": "Updates", "state": "ok", "since": "2026-11-21T07:00:00-05:00", "why": "", "unit": "", "log": "", "run": ""}]}
EOF
else echo '{"worst": "ok", "jobs": []}'; fi
CANNED
mkdir -p "$H/.config/gvm" "$H/.local/state/gvm"
printf 'key 00:11:22:33:44:5a\nfill 00:11:22:33:44:5b\n' > "$H/.config/gvm/lights"
cat > "$H/.config/gvm/presets.json" <<'EOF'
{"Camera": {"note": "Key light left, soft fill right"}, "Reading": {"note": "Both warm and dim"}, "Off": {"note": "Both off"}}
EOF
cat > "$H/.local/state/gvm/lights.json" <<EOF
{"lights": {"key": {"on": 1, "bright": 80, "cct": 4400, "mode": "white", "at": $(date +%s), "by": "window", "hue": 30, "sat": 100},
            "fill": {"on": 1, "bright": 25, "cct": 4400, "mode": "white", "at": $(date +%s), "by": "window", "hue": 30, "sat": 100}}}
EOF
echo '{"captureKey": "j"}' > "$H/.local/state/launcher.json"
mkdir -p "$H/.emacs.d/org/roam"
for n in "Linked lists:linked-lists" "Lecture plan, week 12:week-12" "Office hours notes:office-hours"; do
    printf '#+title: %s\n' "${n%%:*}" > "$H/.emacs.d/org/roam/${n##*:}.org"
    printf '%s\t%s\t%s\n' "$H/.emacs.d/org/roam/${n##*:}.org" "${n%%:*}" "$(date +%s)" >> "$H/.cache/launcher-roam.tsv"
done
mkdir -p "$H/Documents/teaching"; for f in syllabus.org week-12-slides.pdf quiz-4.tex grades.csv; do : > "$H/Documents/teaching/$f"; done
rm -f "$H/.local/bin/lecture-keys"         # the key display reads evdev; here it gets a few made-up presses
cat > "$H/.local/bin/lecture-keys" <<'CANNED'
#!/bin/sh
while :; do
    for k in "Ctrl C" "Ctrl V" "Super+Shift D" "Ctrl+Shift T"; do sleep 0.7; printf '%s\t%s\n' $k; done
    sleep 1
done
CANNED
chmod +x "$H/.local/bin/lecture-keys"
mkdir -p "$H/.config/cosmic/com.system76.CosmicTheme.Mode/v1"
dark_file="$H/.config/cosmic/com.system76.CosmicTheme.Mode/v1/is_dark"; echo true > "$dark_file"

# ---- demo data ----
# Calendar: a made-up teaching day, around the current time so the bar's "next" has something.
mkdir -p "$H/.emacs.d/org/calendars"
python3 -I - "$H/.emacs.d/org/calendars/demo.org" <<'EOF'
import datetime as dt, sys
now = dt.datetime.now().replace(second=0, microsecond=0)
base = now.replace(minute=0) + dt.timedelta(hours=1)   # next whole hour: the lecture is 1-2 h off, never under way
day = now.date(); dn = day.strftime("%a")
def at(h, m=0): return (base + dt.timedelta(hours=h, minutes=m)).strftime("%H:%M")
ev = [("Office hours", at(-3), at(-2), "Room 210"),
      ("Data Structures lecture", at(1), at(1, 50), "Hall B 100"),
      ("Lab: linked lists", at(3), at(4, 15), "Lab 112"),
      ("Curriculum committee", at(5), at(6), "Conference room")]
with open(sys.argv[1], "w") as f:
    f.write("#+title: demo\n")
    f.write(f"* Reading day\n<{day} {dn}>\n")
    for t, s, e, loc in ev:
        f.write(f"* {t}\n:PROPERTIES:\n:LOCATION: {loc}\n:END:\n<{day} {dn} {s}-{e}>\n")
EOF
# The emoji mode's list (Unicode data only), when it has been built here
[ -f "$HOME/.cache/emoji-picker.txt" ] && cp "$HOME/.cache/emoji-picker.txt" "$H/.cache/"
# Text the terminals show
mkdir -p "$H/demo"
sed -n '/^local mainMod/,$p' "$hsrc/hyprland.lua" | head -48 > "$H/demo/keys.lua"
[ -s "$H/demo/keys.lua" ] || head -48 "$hsrc/hyprland.lua" > "$H/demo/keys.lua"
sed -n '/^Item\|^Rectangle\|^MouseArea/,$p' "$qsrc/Pill.qml" | head -48 > "$H/demo/Pill.qml"
[ -s "$H/demo/Pill.qml" ] || head -48 "$qsrc/Pill.qml" > "$H/demo/Pill.qml"

allow="sh dash bash env python3 jq sed awk gawk mawk grep cat date head tail tr cut sort uniq wc printf echo test [
       basename dirname mkdir ls stat readlink realpath seq sleep true false findmnt hyprctl id uname nproc mktemp
       touch rm mv cp ln tee xargs expr od md5sum find timeout qalc qrencode fd fdfind notify-send"
python3 -I - "$P" "$work/rec" $allow <<'EOF'
import os, sys
p, rec, allow = sys.argv[1], sys.argv[2], set(sys.argv[3:])
for d in ("/usr/local/bin", "/usr/bin", "/bin"):
    try: names = os.listdir(d)
    except OSError: continue
    for n in names:
        dst = os.path.join(p, n)
        if os.path.lexists(dst): continue
        os.symlink(os.path.join(d, n) if n in allow else rec, dst)
for n in ("qs", "quickshell", "nixGLIntel", "playerctl", "cava", "pw-play", "wpctl", "pactl"):
    if not os.path.lexists(os.path.join(p, n)): os.symlink(rec, os.path.join(p, n))
EOF

# made-up answers for programs the shell asks directly
rm -f "$P/nmcli" "$P/cliphist"
cat > "$P/nmcli" <<'EOF'
#!/bin/sh
case "$*" in
    *"dev wifi list"*) printf '*:82:WPA2:Campus\n :64:WPA2:Library-5G\n :41::Coffee Shop\n :23::Lab Guest\n' ;;
    *connectivity*) echo full ;;
esac
EOF
cat > "$P/cliphist" <<'EOF'
#!/bin/sh
case "$1" in
    list) printf '3\tgit push origin main\n2\thttps://example.edu/cs2120/syllabus\n1\tGrade quiz 4 by Friday\n' ;;
    decode) read -r l; case "${l%%	*}" in 3) echo "git push origin main" ;; 2) echo "https://example.edu/cs2120/syllabus" ;; *) echo "Grade quiz 4 by Friday" ;; esac ;;
esac
EOF
cat > "$P/ffmpeg" <<'EOF'
#!/bin/sh
# stand-in for the webcam reader: never opens a device, keeps the made-up frame in place
case "$*" in *v4l2*) while :; do cp "$HOME/demo/cam.jpg" "$XDG_RUNTIME_DIR/qs-cam/frame.jpg.part" 2>/dev/null &&
    mv "$XDG_RUNTIME_DIR/qs-cam/frame.jpg.part" "$XDG_RUNTIME_DIR/qs-cam/frame.jpg"; sleep 0.5; done ;; esac
exit 0
EOF
chmod +x "$P/nmcli" "$P/cliphist" "$P/ffmpeg"

pids=()
cleanup() {
    [ -n "${qs_pid:-}" ] && kill -9 "$qs_pid" 2>/dev/null
    for p in "${pids[@]}"; do kill -9 "$p" 2>/dev/null; done
    [ -n "${hypr_pid:-}" ] && kill -9 "$hypr_pid" 2>/dev/null
    [ -n "${bus_pid:-}" ] && kill "$bus_pid" 2>/dev/null
    [ -n "${sbus_pid:-}" ] && kill "$sbus_pid" 2>/dev/null
    wait 2>/dev/null
    if [ "$keep" = 1 ]; then echo "kept $work"; else rm -rf "$work"; fi
}
trap cleanup EXIT

bus=$(dbus-daemon --session --fork --print-address=1 --print-pid=1 --nopidfile) || exit 2
bus_addr=$(sed -n 1p <<<"$bus"); bus_pid=$(sed -n 2p <<<"$bus")
sbus=$(dbus-daemon --session --fork --print-address=1 --print-pid=1 --nopidfile) || exit 2
sbus_addr=$(sed -n 1p <<<"$sbus"); sbus_pid=$(sed -n 2p <<<"$sbus")

base_env=(HOME="$H" USER=demo LOGNAME=demo LANG="${LANG:-C.UTF-8}"
    XDG_RUNTIME_DIR="$R" XDG_CONFIG_HOME="$H/.config" XDG_STATE_HOME="$H/.local/state"
    XDG_CACHE_HOME="$H/.cache" XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    DBUS_SESSION_BUS_ADDRESS="$bus_addr" DBUS_SYSTEM_BUS_ADDRESS="$sbus_addr"
    HYPR_TEST_LOG="$LOG" SBT_LOG="$LOG" NO_AT_BRIDGE=1 GTK_A11Y=none)

env -i "${base_env[@]}" PATH="$htests/stubs:$PATH" XDG_DATA_HOME="$HOME/.local/share" \
    WAYLAND_DISPLAY="$live_wl" LIBSEAT_BACKEND=seatd HYPRLAND_NO_SD_VARS=1 HYPRLAND_NO_SD_NOTIFY=1 \
    Hyprland -c "$H/.config/hypr/hyprland.lua" > "$work/hyprland.out" 2>&1 &
hypr_pid=$!

die() { echo "desktop-shots: $*" >&2; [ "$verbose" = 1 ] && tail -20 "$QLOG" >&2; exit 1; }
sig=""
for _ in $(seq 150); do
    s=$(/bin/ls "$R/hypr" 2>/dev/null | head -1)
    [ -n "$s" ] && [ -S "$R/hypr/$s/.socket.sock" ] && { sig=$s; break; }
    kill -0 "$hypr_pid" 2>/dev/null || break
    sleep 0.1
done
[ -n "$sig" ] || die "nested Hyprland did not come up: $(tail -3 "$work/hyprland.out" | tr '\n' ' ')"
hc() { env XDG_RUNTIME_DIR="$R" HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl "$@"; }
for _ in $(seq 100); do hc version >/dev/null 2>&1 && break; sleep 0.1; done
nested_wl=$(cd "$R" && /bin/ls wayland-* 2>/dev/null | grep -v '\.lock$' | head -1)
until_jq() { local cmd=$1 expr=$2 n=${3:-50}; for _ in $(seq "$n"); do hc -j "$cmd" 2>/dev/null | jq -e "$expr" >/dev/null 2>&1 && return 0; sleep 0.1; done; return 1; }
mon=$(hc -j monitors | jq -r '.[0].name')

# A fixed 1920x1080 screen to photograph; the nested window's own screen is switched off.
SHOT=SHOT-1
hc output create headless "$SHOT" >/dev/null
until_jq monitors 'length == 2' 30
hc eval "hl.monitor({ output = \"$SHOT\", mode = \"1920x1080@60\", position = \"0x0\", scale = 1 })" >/dev/null
hc eval "hl.monitor({ output = \"$mon\", disabled = true })" >/dev/null
until_jq monitors "length == 1 and .[0].name == \"$SHOT\" and .[0].width == 1920" 50 || die "headless $SHOT is not 1920x1080: $(hc -j monitors | jq -c '[.[] | {name,width,height}]')"

# ---- stand-in services, before the shell so it finds them at start ----
# Made-up pictures: an album cover for the music card and a webcam frame for the bubble (the
# bubble shows $XDG_RUNTIME_DIR/qs-cam/frame.jpg; the ffmpeg that would fill it from the real
# camera is a recorder here, so no camera is ever opened).
mkdir -p "$R/qs-cam"
python3 -I - "$H/demo/cover.png" "$R/qs-cam/frame.jpg" "$H/demo/cam.jpg" <<'EOF'
import math, sys
from PIL import Image, ImageDraw, ImageFilter
w = 480
cov = Image.new("RGB", (w, w)); d = ImageDraw.Draw(cov)
for y in range(w):                                  # purple to orange
    t = y / w; d.line([(0, y), (w, y)], fill=(int(82 + (245 - 82) * t), int(45 + (102 - 45) * t), int(128 - 128 * t)))
for r in range(200, 20, -30):
    d.ellipse((w / 2 - r, w / 2 - r, w / 2 + r, w / 2 + r), outline=(255, 240, 230), width=3)
cov.save(sys.argv[1])
cam = Image.new("RGB", (w, w), (58, 52, 70)); d = ImageDraw.Draw(cam)
for y in range(w):                                  # a soft wall
    d.line([(0, y), (w, y)], fill=(70 + y // 12, 62 + y // 14, 84 + y // 16))
d.ellipse((150, 90, 330, 290), fill=(214, 170, 140))                     # head
d.pieslice((60, 300, 420, 700), 180, 360, fill=(245, 102, 0))            # orange shirt
d.ellipse((140, 70, 340, 200), fill=(70, 48, 38)); d.rectangle((150, 130, 330, 170), fill=(214, 170, 140))   # hair
cam = cam.filter(ImageFilter.GaussianBlur(1.2)); cam.save(sys.argv[2], quality=90); cam.save(sys.argv[3], quality=90)
EOF
venv="$HOME/.local/share/desktop-shots/venv"
if [ ! -x "$venv/bin/python" ] || ! "$venv/bin/python" -c 'import dbusmock' 2>/dev/null; then
    echo "desktop-shots: setting up $venv (python-dbusmock)" >&2
    python3 -m venv --system-site-packages "$venv" && "$venv/bin/pip" install -q python-dbusmock >&2
fi
fakes_ok=0
if "$venv/bin/python" -c 'import dbusmock' 2>/dev/null; then
    "$venv/bin/python" "$HOME/.local/bin/desktop-shots-fakes" "$sbus_addr" "$bus_addr" "$H/demo/cover.png" > "$work/fakes.out" 2> "$work/fakes.err" &
    pids+=($!)
    for _ in $(seq 100); do grep -q ready "$work/fakes.out" 2>/dev/null && { fakes_ok=1; break; }; sleep 0.1; done
    [ "$fakes_ok" = 1 ] || echo "desktop-shots: stand-in services did not start: $(tail -2 "$work/fakes.err")" >&2
fi
# Sound: a private PipeWire in the temporary runtime directory, with WirePlumber's device monitors
# off (no ALSA, Bluetooth, V4L2 or libcamera: it cannot open a real device), and made-up devices.
mkdir -p "$H/.config/wireplumber/wireplumber.conf.d"
cat > "$H/.config/wireplumber/wireplumber.conf.d/90-no-devices.conf" <<'EOF'
wireplumber.profiles = {
  main = {
    monitor.alsa = disabled
    monitor.alsa-midi = disabled
    monitor.bluez = disabled
    monitor.bluez-midi = disabled
    monitor.v4l2 = disabled
    monitor.libcamera = disabled
  }
}
EOF
pw_env=(env -i "${base_env[@]}" PATH="/usr/bin:/bin" XDG_DATA_HOME="$H/.local/share")
if command -v pipewire >/dev/null && command -v wireplumber >/dev/null; then
    "${pw_env[@]}" pipewire > "$work/pw.log" 2>&1 & pids+=($!)
    for _ in $(seq 50); do [ -S "$R/pipewire-0" ] && break; sleep 0.1; done
    "${pw_env[@]}" wireplumber > "$work/wp.log" 2>&1 & pids+=($!)
    "${pw_env[@]}" pipewire-pulse > "$work/pwp.log" 2>&1 & pids+=($!)
    for _ in $(seq 50); do [ -S "$R/pulse/native" ] && break; sleep 0.1; done
    pa() { "${pw_env[@]}" pactl "$@" >/dev/null 2>&1; }
    pa load-module module-null-sink sink_name=speakers 'sink_properties=device.description="Laptop speakers"'
    pa load-module module-null-sink sink_name=headphones 'sink_properties=device.description="Headphones"'
    pa load-module module-null-sink sink_name=mic media.class=Audio/Source/Virtual 'sink_properties=device.description="Built-in microphone"'
    pa set-default-sink headphones; pa set-sink-volume headphones 55%; pa set-default-source mic; pa set-source-volume mic 70%
    python3 -I -c "import wave; f = wave.open('$work/silence.wav', 'wb'); f.setnchannels(2); f.setsampwidth(2); f.setframerate(48000); f.writeframes(bytes(48000 * 4 * 600))"
    "${pw_env[@]}" pw-play --target headphones -P '{ application.name = "Firefox" media.name = "Lecture video" }' "$work/silence.wav" >/dev/null 2>&1 & pids+=($!)
fi

qs_env=(env -i "${base_env[@]}" PATH="$P" XDG_DATA_HOME="$H/.local/share"
        WAYLAND_DISPLAY="$nested_wl" HYPRLAND_INSTANCE_SIGNATURE="$sig" XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Hyprland)
if [ -x "$GL" ]; then "${qs_env[@]}" "$GL" "$QS" -n --no-color > "$QLOG" 2>&1 &
else "${qs_env[@]}" QT_QUICK_BACKEND=software "$QS" -n --no-color > "$QLOG" 2>&1 & fi
qs_pid=$!
qsi() { "${qs_env[@]}" "$QS" ipc "$@" 2>&1; }
alive() { kill -0 "$qs_pid" 2>/dev/null; }
for _ in $(seq 150); do [ "$(qsi call bar status)" = shown ] && break; alive || die "the shell died at start"; sleep 0.1; done
[ "$(qsi call bar status)" = shown ] || die "the shell did not answer qs ipc"
layer_on() { hc -j layers 2>/dev/null | jq -e --arg m "$SHOT" --arg ns "$1" '.[$m].levels // {} | [.[][] | select(.namespace == $ns)] | length > 0' >/dev/null; }
until_layer() { for _ in $(seq "${2:-50}"); do layer_on "$1" && return 0; sleep 0.1; done; return 1; }
until_gone() { for _ in $(seq "${2:-30}"); do layer_on "$1" || return 0; sleep 0.1; done; return 1; }
until_layer qs-bar 50 || die "no bar on $SHOT"
hc eval 'hl.config({ cursor = { invisible = true } })' >/dev/null 2>&1
hc eval 'hl.dispatch(hl.dsp.cursor.move({ x = 1919, y = 1079 }))' >/dev/null 2>&1

# Demo windows: two terminals with published files in them (no prompt, no host name), in the
# terminal theme for the mode; bat's "ansi" theme uses the terminal's own palette.
tpids=()
term() {   # term TITLE FILE THEME
    env -i "${base_env[@]}" PATH="/usr/bin:/bin:$HOME/.local/bin" XDG_DATA_HOME="$H/.local/share" \
        WAYLAND_DISPLAY="$nested_wl" GDK_BACKEND=wayland \
        ghostty --gtk-single-instance=false --title="$1" --confirm-close-surface=false --theme="$3" --cursor-style-blink=false --cursor-opacity=0 \
        -e sh -c "bat --paging=never --style=numbers --color=always --theme=ansi '$2' 2>/dev/null || cat '$2'; exec sleep 3600" \
        >/dev/null 2>&1 &
    tpids+=($!); pids+=($!)
}
terms_off() { for p in "${tpids[@]}"; do kill "$p" 2>/dev/null; done; tpids=(); until_jq clients 'length == 0' 50; }
terms_on() {   # terms_on THEME
    term "hyprland.lua" "$H/demo/keys.lua" "$1"; sleep 1.5
    term "Pill.qml" "$H/demo/Pill.qml" "$1"
    until_jq clients 'length >= 2' 100 || echo "desktop-shots: the demo terminals did not both open" >&2
    sleep 1.5
}
sleep "${SHOTS_SETTLE:-6}"           # first polls, wallpaper fade-in

shoot() { env XDG_RUNTIME_DIR="$R" WAYLAND_DISPLAY="$nested_wl" grim -o "$SHOT" "$out/$1.png" && echo "  $out/$1.png"; }
# Pointer and keyboard for the nested session only: the strict-resize plugin's test clients
# (wlr virtual pointer; virtual keyboard with a US keymap, evdev codes), built if missing.
ptests=""
for d in "$HOME/.local/share/hypr-strict-resize/tests" "$src/.local/share/hypr-strict-resize/tests"; do
    [ -x "$d/vptr/vptr" ] && [ -x "$d/vkbd/vkbd" ] && { ptests=$d; break; }
done
if [ -z "$ptests" ] && [ -f "$src/.local/share/hypr-strict-resize/tests/build.sh" ]; then
    cp -r "$src/.local/share/hypr-strict-resize/tests" "$work/ptests" && sh "$work/ptests/build.sh" >/dev/null 2>&1 && ptests="$work/ptests"
fi
ptr() { [ -n "$ptests" ] && env -i XDG_RUNTIME_DIR="$R" WAYLAND_DISPLAY="$nested_wl" "$ptests/vptr/vptr" 1920 1080 "$@"; }
kbd() { [ -n "$ptests" ] && env -i XDG_RUNTIME_DIR="$R" WAYLAND_DISPLAY="$nested_wl" "$ptests/vkbd/vkbd" "$@"; }
notify() { env DBUS_SESSION_BUS_ADDRESS="$bus_addr" /usr/bin/notify-send "$@"; }

if [ "$hold" = 1 ]; then
    { declare -p R sig nested_wl bus_addr sbus_addr H P QS GL SHOT out work ptests base_env qs_env venv dark_file src only anim
      declare -f hc qsi shoot ptr kbd notify layer_on until_layer until_gone until_jq term terms_on terms_off want record
      echo ". $(dirname "$(readlink -f "$0")")/desktop-shots-gallery"; } > "$work/env.sh"
    echo "holding: source $work/env.sh; touch $work/stop to end"
    until [ -e "$work/stop" ]; do sleep 1; alive || break; done
    exit 0
fi

for mode in $modes; do
    [ "$mode" = dark ] && echo true > "$dark_file" || echo false > "$dark_file"
    terms_off
    sleep 2.5
    echo "$mode:"
    want wallpaper && shoot "wallpaper-$mode"
    if [ "$mode" = dark ]; then terms_on "Clemson Dark"; else terms_on "Clemson Light"; fi
    if want desktop || want bar; then
        shoot "desktop-$mode"
        want bar && python3 -I - "$out/desktop-$mode.png" "$out/bar-$mode.png" <<'EOF'
import sys
from PIL import Image
im = Image.open(sys.argv[1]); w, h = im.size
im.crop((0, 0, w, 56)).save(sys.argv[2]); print("  " + sys.argv[2])
EOF
        want desktop || rm -f "$out/desktop-$mode.png"
    fi
    view() {   # view NAME NAMESPACE OPEN... -- CLOSE...
        local name=$1 ns=$2; shift 2; local open=() close=()
        while [ $# -gt 0 ] && [ "$1" != -- ]; do open+=("$1"); shift; done; shift; close=("$@")
        want "$name" || return 0
        qsi call "${open[@]}" >/dev/null
        if until_layer "$ns" 40; then sleep 0.9; shoot "$name-$mode"; else echo "  $name: no $ns layer" >&2; fi
        qsi call "${close[@]}" >/dev/null; until_gone "$ns" 30; sleep 0.4
    }
    view launcher qs-launcher launcher toggle -- launcher toggle
    view panel qs-panel panel toggle -- panel toggle
    view dashboard qs-dashboard dashboard open -- dashboard close
    view overview qs-overview overview toggle -- overview toggle
    view settings qs-settings settings open appearance -- settings close
    if want notifications; then
        notify -a "Calendar" -i x-office-calendar "Data Structures lecture in 10 minutes" "Hall B 100"
        sleep 0.4; notify -a "Build" -i emblem-ok "Lecture slides built" "week-12.pdf, 34 pages"
        sleep 0.4; notify -a "Backup" -i drive-harddisk "Backup finished" "Nothing changed since yesterday"
        sleep 1.2; shoot "notifications-$mode"
        qsi call notif dismissAll >/dev/null; sleep 0.6
    fi
    if want lecture; then      # a circle and an underline in ink, and a timer
        qsi call lecture draw >/dev/null; sleep 0.8
        ptr $(python3 -c "
import math
pts = [(560 + 330 * math.cos(t / 40 * 2 * math.pi), 690 + 70 * math.sin(t / 40 * 2 * math.pi)) for t in range(42)]
print('m %d %d s 80 d s 50 ' % pts[0] + ' '.join('m %d %d s 12' % p for p in pts) + ' u s 200')")
        ptr m 1150 345 s 80 d s 50 m 1300 347 s 20 m 1450 346 s 20 m 1600 348 s 20 m 1780 347 s 100 u s 200
        qsi call lecture timer 10 "Quiz" >/dev/null; sleep 1.2
        shoot "lecture-$mode"
        qsi call lecture off >/dev/null; sleep 0.8
    fi
    if want spotlight; then
        qsi call lecture spotsize 240 >/dev/null; qsi call lecture spot >/dev/null; sleep 0.5
        ptr m 500 650 s 80 m 540 680 s 80 m 560 690 s 300; sleep 0.8
        shoot "spotlight-$mode"
        qsi call lecture off >/dev/null; sleep 0.8
    fi
    if want keys; then         # the key display (fed made-up presses; see lecture-keys above)
        qsi call lecture keys >/dev/null; sleep 3.1; shoot "keys-$mode"
        qsi call lecture off >/dev/null; sleep 0.8
    fi
    if [ "$mode" = dark ]; then
        if want calc; then qsi call launcher openWith "=2^10 + 3*7" >/dev/null; sleep 1.2; shoot calc-dark; qsi call launcher toggle >/dev/null; until_gone qs-launcher 30; sleep 0.4; fi
        if want emoji; then qsi call launcher openWith ":tiger" >/dev/null; sleep 1.2; shoot emoji-dark; qsi call launcher toggle >/dev/null; until_gone qs-launcher 30; sleep 0.4; fi
        if want scenes; then      # every scene on the empty desktop, a quarter size, into one grid
            terms_off; mkdir -p "$work/scenes"
            scenes=$(qsi call wallpaper status | grep -o 'scenes=[^ ]*' | cut -d= -f2 | tr , ' ')
            [ -n "$scenes" ] || scenes="silk aurora contours ink ridges sky terrain flow ripples field pulsar depths"
            for sc in $scenes; do
                qsi call wallpaper scene "$sc" >/dev/null; sleep 2.2
                env XDG_RUNTIME_DIR="$R" WAYLAND_DISPLAY="$nested_wl" grim -o "$SHOT" -s 0.25 "$work/scenes/$sc.png"
            done
            qsi call wallpaper scene silk >/dev/null
            python3 -I - "$work/scenes" "$out/scenes-dark.png" $scenes <<'EOF'
import sys
from PIL import Image, ImageDraw, ImageFont
d, outp, names = sys.argv[1], sys.argv[2], sys.argv[3:]
ims = [Image.open(f"{d}/{n}.png").convert("RGB") for n in names]
w, h = ims[0].size; cols = 4; rows = (len(ims) + cols - 1) // cols; gap = 6
sheet = Image.new("RGB", (cols * w + (cols + 1) * gap, rows * h + (rows + 1) * gap), (14, 12, 20))
try: font = ImageFont.truetype("DejaVuSansMono-Bold.ttf", 15)
except OSError: font = ImageFont.load_default()
for i, (n, im) in enumerate(zip(names, ims)):
    x, y = gap + (i % cols) * (w + gap), gap + (i // cols) * (h + gap)
    im = im.crop((0, 14, w, h)).resize((w, h))          # without the bar
    sheet.paste(im, (x, y)); dr = ImageDraw.Draw(sheet)
    dr.rounded_rectangle((x + 8, y + h - 30, x + 16 + dr.textlength(n, font=font), y + h - 8), 5, fill=(14, 12, 20))
    dr.text((x + 12, y + h - 28), n, fill=(245, 102, 0), font=font)
sheet.save(outp); print("  " + outp)
EOF
            terms_on "Clemson Dark"
        fi
    fi
done

# ---- animations (dark): wf-recorder for SECONDS, then animated WebP ----
record() {   # record NAME SECONDS FILTER ACTION...: ACTION runs in the background while recording
    local name=$1 secs=$2 vf=$3; shift 3
    want "${name%%/*}" || return 0
    command -v wf-recorder >/dev/null || { echo "  $name: no wf-recorder" >&2; return 0; }
    mkdir -p "$(dirname "$work/$name.mkv")" "$(dirname "$out/$name")"
    env XDG_RUNTIME_DIR="$R" WAYLAND_DISPLAY="$nested_wl" timeout -s INT "$secs" \
        wf-recorder -o "$SHOT" -r 30 -c libx264rgb -p crf=0 -p preset=ultrafast -f "$work/$name.mkv" >/dev/null 2>&1 &
    local rp=$!; sleep 0.6; "$@" & local ap=$!; wait "$rp"; wait "$ap" 2>/dev/null
    # Animated AVIF (AV1, 10-bit): smooth gradients at a few hundred KB. WebP blocked up on the dark
    # wallpaper gradients even at quality 90 (2026-11-21), so it is only the fallback without SVT-AV1.
    if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q libsvtav1; then
        ffmpeg -v error -y -i "$work/$name.mkv" -vf "$vf,format=yuv420p10le" -c:v libsvtav1 -crf 26 -preset 6 -g 300 \
            -f avif "$out/$name.avif" 2>/dev/null && echo "  $out/$name.avif ($(du -k "$out/$name.avif" | cut -f1) KB)"
    else
        ffmpeg -v error -y -i "$work/$name.mkv" -vf "$vf" -c:v libwebp_anim -lossless 0 -q:v 90 -preset picture \
            -compression_level 6 -loop 0 "$out/$name.webp" && echo "  $out/$name.webp ($(du -k "$out/$name.webp" | cut -f1) KB)"
    fi
}
if [ "$anim" = 1 ]; then
    echo "animations:"
    echo true > "$dark_file"; terms_off; sleep 2.5
    # the scenes drift slowly by design; sped up for the clip so the motion shows
    qsi call wallpaper force true >/dev/null; qsi call wallpaper speed 0.06 >/dev/null; sleep 1
    record anim-wallpaper 6 "fps=20,scale=1280:-2:flags=lanczos" sleep 0
    qsi call wallpaper speed 0.012 >/dev/null
    a_pet() { sleep 1.5; notify -a "Calendar" -i x-office-calendar "Office hours in 10 minutes" "Room 210"; sleep 3; qsi call notif dismissAll >/dev/null; }
    record anim-pet 7 "crop=1920:260:0:820,fps=20" a_pet
    a_theme() { sleep 1.2; echo false > "$dark_file"; sleep 2.6; echo true > "$dark_file"; }
    qsi call panel open >/dev/null; until_layer qs-panel 40; sleep 0.6
    record anim-theme 7 "fps=20,scale=1280:-2:flags=lanczos" a_theme
    qsi call panel close >/dev/null; until_gone qs-panel 30
    terms_on "Clemson Dark"
    a_island() { sleep 0.8; qsi call island say "Data Structures lecture in 5 minutes" "Hall B 100" >/dev/null; }
    record anim-island 6 "crop=960:200:480:0,fps=24" a_island
fi

# ---- the gallery: every other view (desktop-shots-gallery) ----
if want gallery; then . "$(dirname "$(readlink -f "$0")")/desktop-shots-gallery"; gallery_main; fi

# ---- the editor: needs the virtual keyboard, whose US keymap shows in the bar's layout pill from
# here on, so it comes after everything else (the island is off meanwhile: it would announce the keymap)
if want editor; then
    qsi call island off >/dev/null
    for mode in $modes; do
        [ "$mode" = dark ] && echo true > "$dark_file" || echo false > "$dark_file"
        terms_off; sleep 2; [ "$mode" = dark ] && terms_on "Clemson Dark" || terms_on "Clemson Light"
        qsi call shot edit >/dev/null; until_layer qs-shot 40; sleep 1
        ptr m 300 150 s 100 d s 100 m 900 450 s 100 m 1500 820 s 200 u s 300
        kbd t 30 s 200                                                            # a: arrow
        ptr m 1200 700 s 100 d s 80 m 1000 550 s 80 m 800 400 s 150 u s 200
        kbd t 48 s 200                                                            # b: box
        ptr m 420 260 s 100 d s 80 m 700 330 s 80 m 760 360 s 150 u s 200
        kbd t 49 s 200                                                            # n: numbered steps
        ptr m 400 240 s 100 d s 60 u s 300 m 1250 720 s 100 d s 60 u s 300
        kbd t 45 s 200                                                            # x: pixelate
        ptr m 1100 300 s 100 d s 80 m 1400 380 s 80 m 1450 400 s 150 u s 300
        sleep 0.5; shoot "editor-$mode"
        kbd t 1 s 300; until_gone qs-shot 30                                      # Esc
    done
    qsi call island on >/dev/null
fi
want gallery && gallery_keys

if [ -n "$keys" ]; then   # the key-binding page, from the published config's bindings
    hc -j binds > "$work/binds.json" && mkdir -p "$(dirname "$keys")" && "$HOME/.local/bin/keybind-sheet" --binds "$work/binds.json" --org "$keys"
fi
alive || echo "desktop-shots: the shell died during the run (pictures may be incomplete)" >&2
# ---- the lock screen, last: there is no unlocking it. It reads the theme once at start, so one lock
# per mode (allow_session_lock_restore lets a new lock client take over from a killed one).
want gallery && gallery_late
if want lock; then
    for mode in $modes; do
        [ "$mode" = dark ] && echo true > "$dark_file" || echo false > "$dark_file"
        if [ -x "$GL" ]; then "${qs_env[@]}" LOCK_SCENE=silk "$GL" "$QS" -p "$H/.config/quickshell/lockscreen.qml" --no-color >> "$work/lock.log" 2>&1 &
        else "${qs_env[@]}" LOCK_SCENE=silk QT_QUICK_BACKEND=software "$QS" -p "$H/.config/quickshell/lockscreen.qml" --no-color >> "$work/lock.log" 2>&1 & fi
        lpid=$!; pids+=($lpid); sleep 4; shoot "lock-$mode"; kill -9 "$lpid" 2>/dev/null; sleep 1
    done
fi
if command -v pngquant >/dev/null; then   # palette PNGs, about a quarter of the size; they live in git
    for f in "$out"/*-dark.png "$out"/*-light.png "$out"/gallery/*.png; do
        [ -f "$f" ] && [ "$f" -nt "$work/started" ] && pngquant --quality 65-90 --speed 1 --strip -f --ext .png "$f" 2>/dev/null
    done
fi
if [ "$verbose" = 1 ]; then
    echo "--- shell log (warnings)"; grep -E 'WARN|ERROR' "$QLOG" | head -40
    echo "--- recorded commands (counts)"; cut -d' ' -f1 "$LOG" | sort | uniq -c | sort -rn | head -30
fi
kill -9 "$qs_pid" 2>/dev/null; wait "$qs_pid" 2>/dev/null; qs_pid=""
