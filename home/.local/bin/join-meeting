#!/usr/bin/env python3
"""Open today's online meeting: the one under way, or the next one starting within 10 minutes.

    join-meeting            open its link with xdg-open
    join-meeting --print    print what it would open (JSON: title, start, end, url, state) and open nothing
    join-meeting --now HH:MM   pretend it is that time (testing)
    join-meeting --ahead N     minutes of look-ahead (default 10)

Events come from agenda-day (JOIN_EVENTS=FILE reads a JSON list instead, for tests). Only
timed events with an http(s) link count. Under way wins (the one that began last); else
the soonest to start. Same rule as quickshell/join.js. Exits 1 when there is nothing to join.
"""
import datetime as dt, json, os, re, subprocess, sys

args = sys.argv[1:]
dry, now, ahead = False, None, 10
while args:
    a = args.pop(0)
    if a == "--print": dry = True
    elif a == "--now" and args: now = args.pop(0)
    elif a == "--ahead" and args: ahead = int(args.pop(0))
    else: sys.exit("usage: join-meeting [--print] [--now HH:MM] [--ahead MIN]")

mins = lambda t: int(t[:2]) * 60 + int(t[3:5])
now_m = mins(now) if now else dt.datetime.now().hour * 60 + dt.datetime.now().minute

src = os.environ.get("JOIN_EVENTS")
if src:
    events = json.load(open(src))
else:
    here = os.path.dirname(os.path.realpath(__file__))
    tool = os.path.join(here, "agenda-day")
    if not os.path.exists(tool):
        tool = os.path.expanduser("~/.local/bin/agenda-day")
    events = json.loads(subprocess.run([tool], capture_output=True, text=True, check=True).stdout)

under, soon = [], []
for e in events:
    if e.get("allday") or not e.get("start") or not re.fullmatch(r"https?://\S+", e.get("url") or ""):
        continue
    s = mins(e["start"]); end = mins(e["end"]) if e.get("end") else s + 60
    if s <= now_m < end: under.append(e)
    elif s > now_m and s - now_m <= ahead: soon.append(e)
under.sort(key=lambda e: -mins(e["start"]))
soon.sort(key=lambda e: mins(e["start"]))
pick, state = (under[0], "now") if under else (soon[0], "soon") if soon else (None, "")
if not pick:
    print("join-meeting: no meeting with a link is under way or starting within %d minutes" % ahead, file=sys.stderr)
    sys.exit(1)
info = {"title": pick["title"], "start": pick["start"], "end": pick.get("end", ""), "url": pick["url"], "state": state}
if dry:
    print(json.dumps(info, ensure_ascii=False))
else:
    subprocess.Popen(["xdg-open", pick["url"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
