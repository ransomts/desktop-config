#!/usr/bin/env python3
"""updates-check: what is waiting to be updated on this laptop?  Read-only, no root.

  updates-check [--text]       what is known now: the cache when it is under 6 hours old
                               (and still matches the boot and the package database),
                               otherwise a fresh look (this can take a few seconds)
  updates-check --json         the same as JSON (the default)
  updates-check --refresh      look again now, whatever the cache says
  updates-check --cached       for shell-health: never waits.  Prints the cache (with the
                               reboot row always live); when the cache is old or missing it
                               starts a detached `--refresh` and prints what it has

JSON: {"at": epoch, "rows": [{id, name, count, detail, cmd, ...}], "skipped": ["flatpak: offline", ...]}
  id       apt | flatpak | firmware | nix | reboot
  count    how many things are waiting (0 for nix, which only reports its profile)
  detail   one plain sentence ("4 updates, 1 of them security; lists are 5 days old")
  cmd      what the person would run to act on it (a shell command; never run from here)
  extras   apt: security (count), listsAgeDays (null when unknown)
           nix: generation, changed (epoch)
Rows with nothing to report are left out (apt stays when its lists are old, since the count
could then be wrong).  `skipped` says what could not be asked, quietly.

What it reads: `apt list --upgradable` (uses the lists already on disk; it never runs
`apt update`; Pop!_OS refreshes them with apt-daily.timer), the age of the lists from
/var/lib/apt/periodic/update-success-stamp or the newest file in /var/lib/apt/lists,
`flatpak remote-ls --updates` for --user and --system (needs the network; skipped when there
is no default route, and every call has a timeout), `fwupdmgr get-updates --json
--no-metadata-check` (local metadata only), the Nix profile's last change (no network),
/var/run/reboot-required and the newest installed kernel in /boot against `uname -r`.
Only writes: $XDG_CACHE_HOME/updates-check/cache.json (and a lock file beside it).

Test hooks (environment): UPDATES_CHECK_NOW (epoch), UPDATES_CHECK_TIMEOUT (seconds per
command, default 25), UPDATES_CHECK_TTL (seconds, default 21600), UPDATES_CHECK_ROUTE (stand-in
for /proc/net/route), UPDATES_CHECK_LISTS, UPDATES_CHECK_PERIODIC, UPDATES_CHECK_REBOOT_FILE,
UPDATES_CHECK_BOOT_DIR, UPDATES_CHECK_KERNEL, UPDATES_CHECK_DPKG_STATUS, UPDATES_CHECK_FLATPAK_STAMPS (colon-separated),
UPDATES_CHECK_BOOT_ID,
UPDATES_CHECK_NIX_PROFILE, HOME, XDG_CACHE_HOME, XDG_STATE_HOME, PATH.
"""
import concurrent.futures as cf
import fcntl
import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "updates-check")
CACHE = os.path.join(CACHE_DIR, "cache.json")
NOW = float(os.environ.get("UPDATES_CHECK_NOW") or time.time())
TIMEOUT = float(os.environ.get("UPDATES_CHECK_TIMEOUT") or 25)
TTL = float(os.environ.get("UPDATES_CHECK_TTL") or 6 * 3600)
D = 86400
STALE_LISTS_DAYS = 3        # lists older than this are mentioned in the detail


def env(name, default):
    return os.environ.get(name) or default


# ---------------------------------------------------------------- helpers
class Timeout(Exception):
    pass


def run(argv, timeout=None):
    """(returncode, stdout); raises Timeout; (127, '') when the program is missing."""
    e = dict(os.environ, LC_ALL="C", LANG="C")
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout or TIMEOUT, env=e, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout
    except subprocess.TimeoutExpired:
        raise Timeout(argv[0])
    except OSError:
        return 127, ""


def have(tool):
    for d in os.environ.get("PATH", "").split(":"):
        p = os.path.join(d, tool)
        if d and os.path.isfile(p) and os.access(p, os.X_OK):
            return True
    return False


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def mtime(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return 0.0


def online():
    for line in read(env("UPDATES_CHECK_ROUTE", "/proc/net/route")).splitlines()[1:]:
        f = line.split()
        try:
            if len(f) > 3 and f[1] == "00000000" and int(f[3], 16) & 1:
                return True
        except ValueError:
            pass
    return False


def plural(n, one, many=None):
    return "%d %s" % (n, one if n == 1 else (many or one + "s"))


def ago_days(sec):
    d = sec / D
    if d < 1:
        return "today"
    return "%d day%s ago" % (round(d), "" if round(d) == 1 else "s")


def boot_id():
    return env("UPDATES_CHECK_BOOT_ID", "") or read("/proc/sys/kernel/random/boot_id").strip()


# ---------------------------------------------------------------- checks
def lists_age():
    """Seconds since the apt lists were last refreshed, or None when unknown."""
    periodic = env("UPDATES_CHECK_PERIODIC", "/var/lib/apt/periodic")
    lists = env("UPDATES_CHECK_LISTS", "/var/lib/apt/lists")
    best = mtime(os.path.join(periodic, "update-success-stamp"))
    try:
        for e in os.scandir(lists):
            if e.is_file() and ("InRelease" in e.name or "_Release" in e.name or "Packages" in e.name):
                best = max(best, e.stat().st_mtime)
    except OSError:
        pass
    return max(0.0, NOW - best) if best else None


def check_apt():
    if not have("apt"):
        return None, "apt: not installed"
    try:
        rc, out = run(["apt", "list", "--upgradable"])
    except Timeout:
        return None, "apt: timed out"
    if rc != 0 and not out:
        return None, "apt: failed"
    n = sec = 0
    for line in out.splitlines():
        if "/" not in line or "upgradable" not in line:
            continue                                   # "Listing..." and warnings
        n += 1
        suites = line.split(None, 1)[0].split("/", 1)[1]
        if any(s.endswith("-security") for s in suites.split(",")):
            sec += 1
    age = lists_age()
    stale = age is not None and age > STALE_LISTS_DAYS * D
    if n == 0 and not stale:
        return None, ""
    bits = []
    if n:
        bits.append(plural(n, "package update") + (" (%d security)" % sec if sec else ""))
    else:
        bits.append("no package updates listed")
    if stale:
        bits.append("the lists are %d days old, so this may be out of date" % round(age / D))
    elif age is not None and n:
        bits.append("lists from " + ago_days(age))
    cmd = "sudo apt update && sudo apt upgrade" if stale else "sudo apt upgrade"
    return dict(id="apt", name="Package updates", count=n, detail="; ".join(bits), cmd=cmd, security=sec,
                listsAgeDays=None if age is None else round(age / D, 1)), ""


def flatpak_count(scope):
    rc, out = run(["flatpak", "remote-ls", "--updates", "--" + scope, "--columns=application"])
    if rc != 0:
        raise OSError("flatpak %s failed" % scope)
    return len({l.strip() for l in out.splitlines() if l.strip() and l.strip().lower() != "application id"})


def check_flatpak():
    if not have("flatpak"):
        return None, "flatpak: not installed"
    if not online():
        return None, "flatpak: offline"
    total, notes = 0, []
    with cf.ThreadPoolExecutor(max_workers=2) as ex:
        futs = {s: ex.submit(flatpak_count, s) for s in ("user", "system")}
        counts = {}
        for s, f in futs.items():
            try:
                counts[s] = f.result()
            except Timeout:
                notes.append("flatpak %s: timed out" % s)
            except Exception:
                notes.append("flatpak %s: failed" % s)
    total = sum(counts.values())
    skipped = "; ".join(notes)
    if not total:
        return None, skipped
    where = " and ".join("%d %s" % (n, s) for s, n in counts.items() if n)
    return dict(id="flatpak", name="Flatpak updates", count=total, detail="%s (%s)" % (plural(total, "app or runtime update", "app or runtime updates"), where),
                cmd="flatpak update"), skipped


def check_firmware():
    if not have("fwupdmgr"):
        return None, "firmware: fwupd not installed"
    try:
        rc, out = run(["fwupdmgr", "get-updates", "--json", "--no-metadata-check"])
    except Timeout:
        return None, "firmware: timed out"
    try:
        devices = json.loads(out).get("Devices", [])
    except (ValueError, AttributeError):
        return None, ("firmware: no answer" if rc not in (0, 2) else "")      # exit 2 with no JSON: nothing to update
    names = [d.get("Name", "a device") for d in devices if d.get("Releases")]
    if not names:
        return None, ""
    return dict(id="firmware", name="Firmware updates", count=len(names), detail=", ".join(names[:3]) + (" and more" if len(names) > 3 else ""),
                cmd="fwupdmgr get-updates; fwupdmgr update"), ""


def check_nix():
    cands = [env("UPDATES_CHECK_NIX_PROFILE", ""),
             os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "nix/profiles/profile"),
             os.path.join(HOME, ".local/state/nix/profiles/profile"), os.path.join(HOME, ".nix-profile")]
    for p in cands:
        if not p or not os.path.lexists(p):
            continue
        try:
            st = os.lstat(p)
        except OSError:
            continue
        target = os.readlink(p) if os.path.islink(p) else ""
        m = re.match(r"profile-(\d+)-link$", target)
        gen = int(m.group(1)) if m else None
        age = max(0, NOW - st.st_mtime)
        detail = "profile %schanged %s" % ("generation %d, " % gen if gen else "", ago_days(age))
        return dict(id="nix", name="Nix profile", count=0, detail=detail, cmd="nix profile list", generation=gen, changed=st.st_mtime), ""
    return None, ""


def version_key(v):
    return [int(x) if x.isdigit() else x for x in re.split(r"[.\-]", v)]


def check_reboot():
    """Always live (cheap): a reboot-required flag, or a newer kernel installed than running."""
    cmd = "printf 'Reboot now? [y/N] '; read a; [ \"$a\" = y ] && systemctl reboot"
    flag = env("UPDATES_CHECK_REBOOT_FILE", "/var/run/reboot-required")
    why = []
    if os.path.exists(flag):
        pk = read(flag + ".pkgs").split()
        why.append("an update asked for it" + (" (%s)" % ", ".join(pk[:3]) if pk else ""))
    running = env("UPDATES_CHECK_KERNEL", "") or os.uname().release
    kernels = []
    try:
        for n in os.listdir(env("UPDATES_CHECK_BOOT_DIR", "/boot")):
            if n.startswith("vmlinuz-"):
                kernels.append(n[len("vmlinuz-"):])
    except OSError:
        pass
    if kernels:
        newest = max(kernels, key=version_key)
        try:
            newer = version_key(newest) > version_key(running)
        except TypeError:
            newer = newest != running and sorted([newest, running])[-1] == newest
        if newer:
            why.append("kernel %s is installed, %s is running" % (newest, running))
    if not why:
        return None
    return dict(id="reboot", name="Restart needed", count=1, detail="; ".join(why), cmd=cmd)


# ---------------------------------------------------------------- run
def refresh():
    rows, skipped = [], []
    jobs = (check_apt, check_flatpak, check_firmware, check_nix)
    with cf.ThreadPoolExecutor(max_workers=4) as ex:
        futs = [ex.submit(j) for j in jobs]
        for f in futs:
            try:
                row, note = f.result()
            except Exception as e:
                row, note = None, "%s: %s" % (type(e).__name__, e)
            if row:
                rows.append(row)
            if note:
                skipped.append(note)
    data = dict(at=NOW, boot=boot_id(), dpkg=mtime(env("UPDATES_CHECK_DPKG_STATUS", "/var/lib/dpkg/status")), flatpak=flatpak_stamp(), rows=rows, skipped=skipped)
    save(data)
    return data


def save(data):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = CACHE + ".%d.tmp" % os.getpid()
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, CACHE)
    except OSError:
        pass


def load_cache():
    try:
        d = json.loads(read(CACHE) or "{}")
    except ValueError:
        return None
    return d if isinstance(d, dict) and "rows" in d else None


def flatpak_stamp():
    """Newest change to any Flatpak installation: flatpak touches <installation>/.changed on every deploy."""
    paths = env("UPDATES_CHECK_FLATPAK_STAMPS", os.path.join(HOME, ".local/share/flatpak/.changed") + ":/var/lib/flatpak/.changed")
    return max([mtime(p) for p in paths.split(":") if p] or [0])


def fresh(d):
    if not d:
        return False
    if NOW - float(d.get("at") or 0) > TTL or float(d.get("at") or 0) > NOW + 600:
        return False
    if d.get("boot") and d["boot"] != boot_id():
        return False                                      # rebooted since: the counts are old news
    if mtime(env("UPDATES_CHECK_DPKG_STATUS", "/var/lib/dpkg/status")) > float(d.get("dpkg") or 0) + 1:
        return False                                      # packages changed since (an upgrade was run)
    if flatpak_stamp() > float(d.get("flatpak") or 0) + 1:
        return False                                      # a Flatpak was installed, updated or removed since
    return True


def with_live(d):
    out = dict(d)
    out["rows"] = [r for r in d.get("rows", []) if r.get("id") != "reboot"]
    r = check_reboot()
    if r:
        out["rows"].append(r)
    return out


def refresh_locked():
    """One refresh at a time; the loser waits for the winner's cache or just returns."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(os.path.join(CACHE_DIR, "lock"), "w") as lk:
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return load_cache()
        return refresh()


def spawn_refresh():
    try:
        subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "--refresh", "--quiet"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                         env=os.environ)
    except OSError:
        pass


def text(d):
    lines = []
    for r in d["rows"]:
        lines.append("%-9s %s  [%s]" % (r["id"], r["detail"], r["cmd"]))
    if not lines:
        lines.append("nothing waiting")
    for s in d.get("skipped", []):
        lines.append("skipped  " + s)
    return "\n".join(lines)


def main(argv):
    mode, fmt, quiet = "auto", "json", False
    for a in argv:
        if a == "--json":
            fmt = "json"
        elif a == "--text":
            fmt = "text"
        elif a == "--refresh":
            mode = "refresh"
        elif a == "--cached":
            mode = "cached"
        elif a == "--quiet":
            quiet = True
        else:
            print("usage: updates-check [--json|--text] [--refresh|--cached]", file=sys.stderr)
            return 2
    cache = load_cache()
    if mode == "refresh":
        d = refresh_locked() or cache or dict(at=NOW, rows=[], skipped=[])
    elif mode == "cached":
        d = cache or dict(at=0, rows=[], skipped=[])
        if not fresh(cache):
            spawn_refresh()
    else:
        d = cache if fresh(cache) else (refresh_locked() or cache or dict(at=NOW, rows=[], skipped=[]))
    if quiet:
        return 0
    d = with_live(d)
    print(json.dumps(d, ensure_ascii=False) if fmt == "json" else text(d))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
