#!/bin/sh
# Tell the Quickshell bar that a script-backed pill changed (DND, Bluetooth, drives,
# power profile, recording), so it re-reads them now instead of on its timer.
# The argument (waybar's old signal number) is ignored.
qs="$HOME/.nix-profile/bin/qs"
[ -x "$qs" ] && "$qs" ipc call bar refresh >/dev/null 2>&1
exit 0
