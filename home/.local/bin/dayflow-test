#!/bin/sh
# Tests for the day-flow pieces: calendar-aware Do Not Disturb (Quickshell Quiet/QuietCore +
# quiet.js), Join (join.js, Join.qml, join-meeting), display-menu gone, lock-now, and the
# extra fields of agenda-day.
#
#   dayflow-test               run everything; PASS/FAIL lines and a summary; exit 1 on a failure
#   dayflow-test -v            also print everything Quickshell logged
#   dayflow-test -d DIR        test the config in DIR instead of ~/.config/quickshell
#   dayflow-test -b DIR        take the scripts from DIR instead of ~/.local/bin
#
# Quickshell part (cases in tests/dayflow/shell.qml, stub Sys/Notif/Icons beside it): fake
# clock, fake events, fake Do Not Disturb; nothing real is touched, XDG_STATE_HOME and the
# rules file are temporary. Script parts: stub hyprctl, notif-dnd, systemctl, pkill, pgrep,
# loginctl, notify-send, xdg-open and qs on PATH / in a fake HOME; they only write a log.
verbose=0; src="$HOME/.config/quickshell"; bin="$HOME/.local/bin"
while [ $# -gt 0 ]; do
    case "$1" in
        -v) verbose=1 ;;
        -d) src="$2"; shift ;;
        -b) bin="$2"; shift ;;
        *) echo "usage: dayflow-test [-v] [-d CONFIG_DIR] [-b BIN_DIR]" >&2; exit 2 ;;
    esac
    shift
done
qs="$HOME/.nix-profile/bin/qs"
tests="$src/tests/dayflow"
[ -x "$qs" ] && [ -f "$tests/shell.qml" ] || { echo "dayflow-test: no qs, or no $tests/shell.qml" >&2; exit 2; }
work=$(mktemp -d) || exit 2
trap 'rm -rf "$work"' EXIT
ok=0
pass() { echo "PASS $1"; }
fail() { echo "FAIL $1${2:+   [$2]}"; ok=1; }
check() { if [ "$2" = 0 ]; then pass "$1"; else fail "$1" "$3"; fi; }

# ---------------- Quickshell part ----------------
mkdir -p "$work/cfg" "$work/state"
cp "$src/QuietCore.qml" "$src/Quiet.qml" "$src/Join.qml" "$src/quiet.js" "$src/join.js" "$work/cfg/"
cp "$tests"/*.qml "$work/cfg/"
log="$work/log"
env -u WAYLAND_DISPLAY -u DISPLAY -u HYPRLAND_INSTANCE_SIGNATURE -u QT_QPA_PLATFORMTHEME -u QT_STYLE_OVERRIDE \
    QT_QPA_PLATFORM=offscreen XDG_STATE_HOME="$work/state" QUIET_RULES="$work/rules/quiet.json" \
    dbus-run-session -- timeout 120 "$qs" -p "$work/cfg/shell.qml" --no-color > "$log" 2>&1
code=$?
[ "$verbose" = 1 ] && cat "$log"
grep -o 'DAYTEST \(PASS\|FAIL\|case:\|RESULT\).*' "$log" | sed 's/^DAYTEST //'
if ! grep -q 'DAYTEST RESULT' "$log"; then
    echo "dayflow-test: the Quickshell run did not finish (exit $code). Last lines:" >&2
    grep -vE 'dbus-daemon|portal' "$log" | tail -15 >&2
    exit 2
fi
grep -q 'DAYTEST RESULT pass [0-9]* fail 0$' "$log" || ok=1
if grep -q '\(Quiet\|QuietCore\|Join\)\.qml.*\(TypeError\|ReferenceError\|Binding loop\|Cannot assign\)' "$log"; then
    echo "FAIL Quiet/Join logged errors:"; grep '\(Quiet\|QuietCore\|Join\)\.qml' "$log" | sort -u | head -8; ok=1
fi

# ---------------- script parts: stubs ----------------
fake="$work/home"; stubs="$work/stubs"; calls="$work/calls"; rt="$work/run"
mkdir -p "$fake/.local/bin" "$fake/.nix-profile/bin" "$fake/.config/hypr" "$stubs" "$rt"
: > "$calls"
for c in notif-dnd bar-refresh; do printf '#!/bin/sh\necho "%s $*" >> "%s"\n' "$c" "$calls" > "$fake/.local/bin/$c"; done
printf '#!/bin/sh\necho "qs $*" >> "%s"\n' "$calls" > "$fake/.nix-profile/bin/qs"
for c in systemctl pkill notify-send loginctl xdg-open; do printf '#!/bin/sh\necho "%s $*" >> "%s"\n' "$c" "$calls" > "$stubs/$c"; done
printf '#!/bin/sh\n[ -e "%s/hypridle-running" ] && { echo "pgrep $*" >> "%s"; exit 0; }\nexit 1\n' "$work" "$calls" > "$stubs/pgrep"
# hyprctl: `monitors all -j` prints $work/monitors.json; HYPRCTL_FAIL=1 makes it fail
cat > "$stubs/hyprctl" <<STUB
#!/bin/sh
echo "hyprctl \$*" >> "$calls"
[ -n "\$HYPRCTL_FAIL" ] && exit 1
case "\$*" in "monitors all -j") cat "$work/monitors.json" ;; esac
STUB
printf '#!/bin/sh\necho "lock-screen $*" >> "%s"\n' "$calls" > "$work/lock-screen"
chmod +x "$fake/.local/bin/"* "$fake/.nix-profile/bin/"* "$stubs/"* "$work/lock-screen"
printf 'monitor({ output = "desc:Dell U2720Q" })\n' > "$fake/.config/hypr/hyprland.lua"
laptop='{"name":"eDP-1","description":"BOE"}'
dell='{"name":"DP-3","description":"Dell U2720Q"}'
proj='{"name":"HDMI-A-1","description":"Epson projector"}'
runmenu() { env HOME="$fake" PATH="$stubs:$PATH" XDG_RUNTIME_DIR="$rt" DISPLAY_MENU_SETTLE=0 "$@"; }
sh_bin="$bin/display-menu"

echo "case: display-menu gone"
# not presenting, no projector: does nothing
rm -f "$rt/presenting"; : > "$calls"; echo "[$laptop,$dell]" > "$work/monitors.json"
runmenu sh "$sh_bin" gone
[ ! -s "$calls" ] || ! grep -qE 'notif-dnd|systemctl|notify-send' "$calls"; check "gone when not presenting does nothing" $? "$(cat "$calls")"
# presenting, projector still connected: does nothing
: > "$rt/presenting"; : > "$calls"; echo "[$laptop,$dell,$proj]" > "$work/monitors.json"
runmenu sh "$sh_bin" gone
{ [ -e "$rt/presenting" ] && ! grep -qE 'notif-dnd|systemctl|notify-send' "$calls"; }; check "gone with a projector still there keeps presenting" $? "$(cat "$calls")"
# presenting, projector gone: unpresent
: > "$calls"; echo "[$laptop,$dell]" > "$work/monitors.json"
runmenu sh "$sh_bin" gone
{ [ ! -e "$rt/presenting" ] && grep -q 'notif-dnd off' "$calls" && grep -q 'systemctl --user start hypridle.service' "$calls" \
  && grep -q 'qs ipc call lecture off' "$calls" && grep -q 'qs ipc call quiet resync' "$calls" && grep -q 'notify-send .*Presenting ended' "$calls"; }; check "gone with no projector ends presenting" $? "$(cat "$calls")"
# a second call is harmless
: > "$calls"; runmenu sh "$sh_bin" gone
! grep -qE 'notif-dnd|systemctl' "$calls"; check "gone again does nothing" $? "$(cat "$calls")"
# a disabled-but-connected projector still counts (monitors all)
: > "$rt/presenting"; : > "$calls"; echo "[$laptop,$dell,$proj]" > "$work/monitors.json"
runmenu sh "$sh_bin" gone; [ -e "$rt/presenting" ]; check "a connected projector counts even if disabled" $?
# hyprctl failing: do not end a presentation on a guess
: > "$calls"; echo "[$laptop,$dell]" > "$work/monitors.json"
runmenu env HYPRCTL_FAIL=1 sh "$sh_bin" gone; [ -e "$rt/presenting" ]; check "hyprctl failing leaves presenting on" $?
# only the laptop and desk monitors left but presenting was on: ends
runmenu sh "$sh_bin" gone; [ ! -e "$rt/presenting" ]; check "laptop + desk monitors only: ends" $?
# check mode unchanged
: > "$calls"; echo "[$laptop,$dell,$proj]" > "$work/monitors.json"; runmenu sh "$sh_bin" check
grep -q 'notify-send .*HDMI-A-1' "$calls"; check "check still announces a projector" $? "$(cat "$calls")"

echo "case: lock-now"
rm -f "$work/hypridle-running"; : > "$calls"
env PATH="$stubs:$PATH" LOCK_SCREEN="$work/lock-screen" sh "$bin/lock-now"
{ grep -q '^lock-screen' "$calls" && ! grep -q loginctl "$calls"; }; check "hypridle stopped (presenting): runs lock-screen directly" $? "$(cat "$calls")"
: > "$work/hypridle-running"; : > "$calls"
env PATH="$stubs:$PATH" LOCK_SCREEN="$work/lock-screen" sh "$bin/lock-now"
{ grep -q '^loginctl lock-session' "$calls" && ! grep -q '^lock-screen' "$calls"; }; check "hypridle running: loginctl lock-session" $? "$(cat "$calls")"

echo "case: join-meeting"
cat > "$work/events.json" <<'JSON'
[{"start":"","end":"","title":"All day","allday":true,"url":"https://all.example/1"},
 {"start":"09:00","end":"10:00","title":"Under way","allday":false,"url":"https://a.example/1"},
 {"start":"09:55","end":"10:30","title":"Overlaps","allday":false,"url":"https://b.example/2"},
 {"start":"11:00","end":"11:30","title":"Later","allday":false,"url":"https://c.example/3"},
 {"start":"11:05","end":"11:30","title":"No link","allday":false,"url":""},
 {"start":"12:00","end":"12:30","title":"File link","allday":false,"url":"file:///etc/passwd"},
 {"start":"13:00","end":"","title":"No end","allday":false,"url":"https://d.example/4"}]
JSON
jm() { env PATH="$stubs:$PATH" JOIN_EVENTS="$work/events.json" python3 "$bin/join-meeting" "$@"; }
title() { python3 -c 'import json,sys; print(json.load(sys.stdin)["title"])'; }
[ "$(jm --print --now 09:30 | title)" = "Under way" ]; check "under way beats upcoming" $?
[ "$(jm --print --now 09:56 | title)" = "Overlaps" ]; check "the one that began last wins when two are under way" $?
[ "$(jm --print --now 10:45 2>&1 | head -1)" != "" ] && ! jm --print --now 10:45 >/dev/null 2>&1; check "nothing within 10 minutes: exit 1" $?
[ "$(jm --print --now 10:50 | title)" = "Later" ]; check "starts in 10 minutes: shown" $?
! jm --print --now 10:49 >/dev/null 2>&1; check "starts in 11 minutes: not shown" $?
! jm --print --now 11:40 >/dev/null 2>&1; check "after the end: not shown" $?
! jm --print --now 12:00 >/dev/null 2>&1; check "file:// link refused" $?
[ "$(jm --print --now 13:30 | title)" = "No end" ]; check "no end taken as an hour" $?
: > "$calls"; jm --now 09:30; sleep 0.3
grep -q '^xdg-open https://a.example/1$' "$calls"; check "opens the link with xdg-open" $? "$(cat "$calls")"
: > "$calls"; jm --print --now 09:30 >/dev/null; [ ! -s "$calls" ]; check "--print opens nothing" $?

echo "case: agenda-day fields"
"$bin/agenda-day" | python3 -c '
import json, sys
d = json.load(sys.stdin)
need = {"start","end","title","allday","location","url","date","id","calendar","tags"}
bad = [e for e in d if not need <= set(e) or not isinstance(e["tags"], list) or not isinstance(e["calendar"], str)]
sys.exit(1 if bad else 0)'; check "every event has calendar and tags beside the old fields" $?
"$bin/agenda-day" 2026-11-13 | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(len(d), "events;", sum(1 for e in d if e["calendar"]), "with a calendar")' >/dev/null; check "agenda-day runs for a past day" $?
exit $ok
