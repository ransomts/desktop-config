# frames 0-3 share one shell; only the head, the legs and the tail change
def t_frame(head, legs, tail=("", "")):
    """head: rows 8-11 for cols 12-15; legs: rows 13-14; tail: rows 11-12, col 0"""
    rows = [BLANK] * 6 + [
        "....ooooo.......",
        "..oodpppdoo.....",
        ".oodpooopdoo....",
        ".odddddddddo....",
        ".odpodpodpdo....",
        ".sssssssssss....",
        "..wwwwwwwww.....",
    ] + legs + [BLANK]
    for i, h in enumerate(head):
        rows[8 + i] = rows[8 + i][:12] + h
    for i, t in enumerate(tail):
        if t: rows[11 + i] = t + rows[11 + i][1:]
    return rows
