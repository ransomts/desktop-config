                ("dragon", 9): (12.5, 4), ("dragon", 10): (12, 9), ("dragon", 11): (12.5, 4)})
def head_top(grid):
    for y, row in enumerate(grid):
        xs = [x for x, ch in enumerate(row) if ch != "." and x >= 6]
        if xs:
            return (round(sum(xs) / len(xs) + 0.5, 1), y)
    return (12, 2)
anchors = {a: [list(BY_HAND.get((a, f), head_top(g))) for f, g in enumerate(frames)] for a, (frames, _) in ANIMALS.items()}
# Where the middle of the back is in each frame (PetPlay.qml seats a riding bird there): the
# highest point of the four columns from eight to five behind the middle of the head.
def back_top(grid, head):
    cols = [x for x in range(int(round(head[0])) - 8, int(round(head[0])) - 4) if 0 <= x < 16] or [6]
    tops = [next((y for y, row in enumerate(grid) if row[x] != "."), 15) for x in cols]
    return [sum(cols) / len(cols) + 0.5, min(tops)]
# The flying dragon's raised wing is not its back: the rider sits on the body below it.
BACK_BY_HAND = {("dragon", 9): [6.0, 7]}
backs = {a: [BACK_BY_HAND.get((a, f)) or back_top(g, anchors[a][f]) for f, g in enumerate(frames)] for a, (frames, _) in ANIMALS.items()}
